# rupantara benchmarks — the forward's hot ops at GPT-2-class shapes.
# docs/benchmarks.md holds the numbers; scripts/bench-history.sh records them.
#
# Pattern: bench_new -> bench_batch_start -> loop -> bench_batch_stop -> bench_report.
# Shapes:
#   - ru_attn_core_fwd T=128 C=768 nh=12        (GPT-2 heads, hd=64; scores + softmax + PV)
#   - ru_attn_core_fwd T=128 C=768 nh=12 nkv=4  (the same with GQA)
#   - ru_attn_core_fwd_row pos=511 C=768 nh=12  (one decode step's attention at a 512 context)
#   - ru_head_fwd_row C=768 V=12564             (a quarter of GPT-2's weight-tied LM head, one row)
#   - ru_ln_fwd 64x768, ru_gelu_fwd 64x3072 (and ru_gelu_fwd_t, 0.6.1), ru_softmax_fwd 1x50257,
#     ru_embed_fwd 64x768
#   - ru_model_fwd / ru_model_fwd_row on a small GPT (V=1024 C=256 T=64 nh=4 NL=2 F=1024, bias),
#     allocating and on caller scratch (the _s entries, 0.5.2)
#   - GPT-2 small (V=50257 C=768 T=1024 nh=12 NL=12 F=3072, bias; 124M params, 1 GB f64,
#     synthetic): a 128-token prefill through the T=1024 layout (ru_model_fwd_n_s, 0.6.0)
#     and one decode step at pos=1023 (the full-context worst case), each with tokens/s
# Labels are stable across releases: scripts/bench-history.sh keys bench-history.csv on them.
include "src/lib.cyr"

# deterministic fill in [-1, 1]
fn _bfill(p, n, salt): i64 {
    var i = 0;
    while (i < n) {
        var m = ((i + salt) * 37 + 11) % 101 - 50;
        store64(p + i * 8, f64_div(f64_from(m), f64_from(50)));
        i = i + 1;
    }
    return 0;
}

# Attention core over a (T, C) window with nh query heads and nkv K/V heads.
fn _bench_core(T, C, nh, nkv, iters, label): i64 {
    var Ckv = nkv * (C / nh);
    var Qc = t_alloc(T * C);
    var Kc = t_alloc(T * Ckv);
    var Vc = t_alloc(T * Ckv);
    var Pc = t_alloc(nh * T * T);
    var concat = t_alloc(T * C);
    _bfill(Qc, T * C, 1);
    _bfill(Kc, T * Ckv, 2);
    _bfill(Vc, T * Ckv, 3);
    var b = bench_new(label);
    bench_batch_start(b);
    var i = 0;
    while (i < iters) { ru_attn_core_fwd(Qc, Kc, Vc, Pc, concat, T, C, nh, nkv); i = i + 1; }
    bench_batch_stop(b, iters);
    bench_report(b);
    return 0;
}

# One decode step's attention core: a query against `pos + 1` cached rows.
fn bench_core_row(): i64 {
    var C = 768; var nh = 12; var nkv = 12; var pos = 511;
    var Ckv = nkv * (C / nh);
    var q = t_alloc(C);
    var Kc = t_alloc((pos + 1) * Ckv);
    var Vc = t_alloc((pos + 1) * Ckv);
    var prow = t_alloc(pos + 1);
    var cr = t_alloc(C);
    _bfill(q, C, 4);
    _bfill(Kc, (pos + 1) * Ckv, 5);
    _bfill(Vc, (pos + 1) * Ckv, 6);
    var b = bench_new("ru_attn_core_fwd_row pos=511 C=768 nh=12");
    bench_batch_start(b);
    var i = 0;
    while (i < 50) { ru_attn_core_fwd_row(q, Kc, Vc, prow, cr, pos, C, nh, nkv); i = i + 1; }
    bench_batch_stop(b, 50);
    bench_report(b);
    return 0;
}

# the weight-tied LM head for one row: V dot products of length C
fn bench_head_row(): i64 {
    var C = 768; var V = 12564;
    var f = t_alloc(C);
    var E = t_alloc(V * C);
    var lg = t_alloc(V);
    _bfill(f, C, 7);
    _bfill(E, V * C, 8);
    var b = bench_new("ru_head_fwd_row C=768 V=12564 (1/4 LM head row)");
    bench_batch_start(b);
    var i = 0;
    while (i < 10) { ru_head_fwd_row(f, E, lg, C, V); i = i + 1; }
    bench_batch_stop(b, 10);
    bench_report(b);
    return 0;
}

# LayerNorm, GELU, softmax and the embedding at GPT-2-class sizes
fn bench_leaf_ops(): i64 {
    var M = 64; var C = 768; var F = 3072; var V = 50257;
    var x = t_alloc(M * C);
    var g = t_alloc(C);
    var be = t_alloc(C);
    var y = t_alloc(M * C);
    var mu = t_alloc(M);
    var rs = t_alloc(M);
    _bfill(x, M * C, 9);
    _bfill(g, C, 10);
    _bfill(be, C, 11);
    var b1 = bench_new("ru_ln_fwd 64x768");
    bench_batch_start(b1);
    var i = 0;
    while (i < 200) { ru_ln_fwd(x, g, be, y, mu, rs, M, C); i = i + 1; }
    bench_batch_stop(b1, 200);
    bench_report(b1);
    var h = t_alloc(M * F);
    var hy = t_alloc(M * F);
    _bfill(h, M * F, 12);
    var b2 = bench_new("ru_gelu_fwd n=64x3072");
    bench_batch_start(b2);
    i = 0;
    while (i < 20) { ru_gelu_fwd(h, hy, M * F); i = i + 1; }
    bench_batch_stop(b2, 20);
    bench_report(b2);
    var ht = t_alloc(M * F);
    var b2t = bench_new("ru_gelu_fwd_t n=64x3072 (also writes tanh, 0.6.1)");
    bench_batch_start(b2t);
    i = 0;
    while (i < 20) { ru_gelu_fwd_t(h, hy, ht, M * F); i = i + 1; }
    bench_batch_stop(b2t, 20);
    bench_report(b2t);
    var lg = t_alloc(V);
    var pr = t_alloc(V);
    _bfill(lg, V, 13);
    var b3 = bench_new("ru_softmax_fwd 1x50257");
    bench_batch_start(b3);
    i = 0;
    while (i < 50) { ru_softmax_fwd(lg, pr, 1, V); i = i + 1; }
    bench_batch_stop(b3, 50);
    bench_report(b3);
    var Vt = 1024;
    var tok = t_alloc(M);
    i = 0;
    while (i < M) { store64(tok + i * 8, (i * 7 + 3) % Vt); i = i + 1; }
    var te = t_alloc(Vt * C);
    var pe = t_alloc(M * C);
    _bfill(te, Vt * C, 14);
    _bfill(pe, M * C, 15);
    var b4 = bench_new("ru_embed_fwd 64x768");
    bench_batch_start(b4);
    i = 0;
    while (i < 500) { ru_embed_fwd(tok, te, pe, y, M, C); i = i + 1; }
    bench_batch_stop(b4, 500);
    bench_report(b4);
    return 0;
}

# The whole forward and one decode step on a small GPT.
fn bench_model(): i64 {
    var V = 1024; var C = 256; var T = 64; var nh = 4; var nkv = 4; var NL = 2; var F = 1024;
    var cfg = t_alloc(8);
    ru_cfg_init(cfg, V, C, T, nh, nkv, NL, F, 1);
    var np = ru_params_count(cfg);
    var params = t_alloc(np);
    _bfill(params, np, 16);
    var tokens = t_alloc(T);
    var i = 0;
    while (i < T) { store64(tokens + i * 8, (i * 5 + 1) % V); i = i + 1; }
    var logits = t_alloc(T * V);
    var probs = t_alloc(T * V);
    var b1 = bench_new("ru_model_fwd V=1024 C=256 T=64 nh=4 NL=2 F=1024");
    bench_batch_start(b1);
    i = 0;
    while (i < 5) { ru_model_fwd(cfg, params, tokens, logits, probs); i = i + 1; }
    bench_batch_stop(b1, 5);
    bench_report(b1);
    # decode: fill the cache for positions 0..T-2, then time the last step
    var kv = t_alloc(ru_decode_kv_count(cfg));
    var row = t_alloc(V);
    var pos = 0;
    while (pos < T - 1) {
        ru_model_fwd_row(cfg, params, load64(tokens + pos * 8), pos, kv, row);
        pos = pos + 1;
    }
    var b2 = bench_new("ru_model_fwd_row pos=63 (same model, one decode step)");
    bench_batch_start(b2);
    i = 0;
    while (i < 50) { ru_model_fwd_row(cfg, params, load64(tokens + pos * 8), pos, kv, row); i = i + 1; }
    bench_batch_stop(b2, 50);
    bench_report(b2);
    # the same two entries on caller-owned scratch (0.5.2): no allocation, no zero-fill
    var sc = t_alloc(ru_model_scratch_count(cfg));
    var b3 = bench_new("ru_model_fwd_s (same model, caller scratch)");
    bench_batch_start(b3);
    i = 0;
    while (i < 5) { ru_model_fwd_s(cfg, params, tokens, logits, probs, sc); i = i + 1; }
    bench_batch_stop(b3, 5);
    bench_report(b3);
    var ds = t_alloc(ru_decode_scratch_count(cfg));
    var b4 = bench_new("ru_model_fwd_row_s pos=63 (same model, caller scratch)");
    bench_batch_start(b4);
    i = 0;
    while (i < 50) { ru_model_fwd_row_s(cfg, params, load64(tokens + pos * 8), pos, kv, row, ds); i = i + 1; }
    bench_batch_stop(b4, 50);
    bench_report(b4);
    return 0;
}

# "    = <x.y> tokens/s" for a benchmark whose iteration processed ntok tokens (a line
# bench-history.sh does not parse: it starts with '=')
fn _bench_tps(b, ntok): i64 {
    var ns = bench_avg_ns(b);
    if (ns <= 0) { return 0; }
    var t10 = ntok * 10000000000 / ns;
    sys_write(1, "    = ", 6);
    fmt_int(t10 / 10);
    sys_write(1, ".", 1);
    fmt_int(t10 % 10);
    sys_write(1, " tokens/s\n", 10);
    return 0;
}

# GPT-2 small at its real dims with synthetic weights (values do not change the time).
# Prefill: a 128-token prompt through the T = 1024 layout on caller scratch, logits only.
# Decode: one cached step at the window's last position against a KV cache filled
# synthetically (decoding 1,023 steps to fill it would take minutes).
fn bench_gpt2(): i64 {
    var V = 50257; var C = 768; var T = 1024; var nh = 12; var NL = 12; var F = 3072;
    var cfg = t_alloc(8);
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, F, 1);
    var np = ru_params_count(cfg);
    var params = t_alloc(np);
    _bfill(params, np, 17);
    var n = 128;
    var tokens = t_alloc(n);
    var i = 0;
    while (i < n) { store64(tokens + i * 8, (i * 389 + 7) % V); i = i + 1; }
    var logits = t_alloc(n * V);
    var sc = t_alloc(ru_model_scratch_count(cfg));
    var b1 = bench_new("GPT-2 small prefill n=128 (T=1024 layout, logits only)");
    bench_batch_start(b1);
    i = 0;
    while (i < 2) { ru_model_fwd_n_s(cfg, params, tokens, n, logits, 0, sc); i = i + 1; }
    bench_batch_stop(b1, 2);
    bench_report(b1);
    _bench_tps(b1, n);
    var nkv = ru_decode_kv_count(cfg);
    var kv = t_alloc(nkv);
    _bfill(kv, nkv, 18);
    var row = t_alloc(V);
    var ds = t_alloc(ru_decode_scratch_count(cfg));
    var b2 = bench_new("GPT-2 small decode step pos=1023 (caller scratch)");
    bench_batch_start(b2);
    i = 0;
    while (i < 5) { ru_model_fwd_row_s(cfg, params, 464, T - 1, kv, row, ds); i = i + 1; }
    bench_batch_stop(b2, 5);
    bench_report(b2);
    _bench_tps(b2, 1);
    return 0;
}

# runs every benchmark in a fixed order (bench-history.csv keys on the labels)
fn main(): i64 {
    alloc_init();
    _bench_core(128, 768, 12, 12, 5, "ru_attn_core_fwd T=128 C=768 nh=12");
    _bench_core(128, 768, 12, 4, 5, "ru_attn_core_fwd T=128 C=768 nh=12 nkv=4");
    bench_core_row();
    bench_head_row();
    bench_leaf_ops();
    bench_model();
    bench_gpt2();
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
