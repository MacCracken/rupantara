# tests/tcyr/ops.tcyr — rupantara leaf ops (M1): LayerNorm + GELU.
include "src/lib.cyr"
include "lib/assert.cyr"
include "tests/common.cyr"     # f64_close, tol_*

# LayerNorm of [1,2,3] with gamma=1,beta=0 → mean 2, symmetric, mean-0 unit-var.
fn test_ln_fwd() {
    var C = 3;
    var x = alloc(C * 8);
    store64(x + 0, f64_from(1));
    store64(x + 8, f64_from(2));
    store64(x + 16, f64_from(3));
    var gamma = alloc(C * 8);
    var beta = alloc(C * 8);
    var i = 0;
    while (i < C) { store64(gamma + i * 8, f64_from(1)); store64(beta + i * 8, f64_from(0)); i = i + 1; }
    var y = alloc(C * 8);
    var mean = alloc(8);
    var rstd = alloc(8);
    ru_ln_fwd(x, gamma, beta, y, mean, rstd, 1, C);

    assert(f64_close(load64(mean), f64_from(2), tol_1e9()), "ln cached mean == 2");
    assert(f64_close(load64(y + 8), f64_from(0), tol_1e6()), "ln y[1] (x==mu) ~ 0");
    assert(f64_close(load64(y + 0), f64_sub(f64_from(0), load64(y + 16)), tol_1e9()), "ln symmetric");
    var s = f64_add(f64_add(load64(y + 0), load64(y + 8)), load64(y + 16));
    assert(f64_close(s, f64_from(0), tol_1e6()), "ln row-sum ~ 0");
    var ss = f64_add(f64_add(f64_mul(load64(y + 0), load64(y + 0)),
        f64_mul(load64(y + 8), load64(y + 8))),
      f64_mul(load64(y + 16), load64(y + 16)));
    assert(f64_close(ss, f64_from(3), tol_1e3()), "ln sum-of-squares ~ C (unit var)");
    return 0;
}

# GELU: g(0)=0 exact, g(10)~10, g(-10)~0, g(1)~0.8412.
fn test_gelu_fwd() {
    var n = 4;
    var x = alloc(n * 8);
    var y = alloc(n * 8);
    store64(x + 0, f64_from(0));
    store64(x + 8, f64_from(10));
    store64(x + 16, f64_sub(f64_from(0), f64_from(10)));
    store64(x + 24, f64_from(1));
    ru_gelu_fwd(x, y, n);

    assert_eq(load64(y + 0), f64_from(0), "gelu(0) == 0 exactly");
    assert(f64_close(load64(y + 8), f64_from(10), tol_1e3()), "gelu(10) ~ 10");
    assert(f64_close(load64(y + 16), f64_from(0), tol_1e3()), "gelu(-10) ~ 0");
    var e1 = f64_div(f64_from(8412), f64_from(10000));   # 0.8412
    assert(f64_close(load64(y + 24), e1, f64_div(f64_from(5), f64_from(10000))), "gelu(1) ~ 0.8412");
    return 0;
}

# the tanh a GELU backward recomputes for x, in attn11's gelu_bwd form (x2 = x*x, x3 = x2*x)
fn _bwd_tanh(xv): i64 {
    var x2 = f64_mul(xv, xv);
    var x3 = f64_mul(x2, xv);
    return f64_tanh(f64_mul(_ru_gelu_c(), f64_add(xv, f64_mul(_ru_gelu_a(), x3))));
}

# ru_gelu_fwd_t (0.6.1): y bit-identical to ru_gelu_fwd's and t bit-identical to the tanh a
# backward recomputes, over x = (i - 400) / 40 (i < 801) plus edge values, and in place.
fn test_gelu_fwd_t() {
    var n = 809;
    var x = alloc(n * 8);
    var i = 0;
    while (i < 801) { store64(x + i * 8, f64_div(f64_from(i - 400), f64_from(40))); i = i + 1; }
    store64(x + 801 * 8, 0);                                    # +0
    store64(x + 802 * 8, 0x8000000000000000);                   # -0
    store64(x + 803 * 8, 1);                                    # the smallest subnormal
    store64(x + 804 * 8, f64_from(1000));
    store64(x + 805 * 8, f64_sub(f64_from(0), f64_from(1000)));
    store64(x + 806 * 8, f64_from(30));
    store64(x + 807 * 8, f64_div(f64_from(1), f64_from(1000000)));
    store64(x + 808 * 8, f64_sub(f64_from(0), f64_from(5)));
    var y0 = alloc(n * 8);
    var y1 = alloc(n * 8);
    var t = alloc(n * 8);
    ru_gelu_fwd(x, y0, n);
    ru_gelu_fwd_t(x, y1, t, n);
    assert_eq(bits_diff(y0, y1, n), 0, "ru_gelu_fwd_t y == ru_gelu_fwd y, bit for bit");
    var td = 0;
    i = 0;
    while (i < n) {
        if (load64(t + i * 8) != _bwd_tanh(load64(x + i * 8))) { td = td + 1; }
        i = i + 1;
    }
    assert_eq(td, 0, "ru_gelu_fwd_t t == the backward's recomputed tanh, bit for bit");
    var xc = alloc(n * 8);
    var t2 = alloc(n * 8);
    t_copy(xc, x, n);
    ru_gelu_fwd_t(xc, xc, t2, n);
    assert_eq(bits_diff(xc, y0, n) + bits_diff(t2, t, n), 0, "ru_gelu_fwd_t in place (y == x)");
    return 0;
}

# runs the suite; the exit code is the failure count
fn main(): i64 {
    alloc_init();
    test_ln_fwd();
    test_gelu_fwd();
    test_gelu_fwd_t();
    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
