# tests/tcyr/smoke.tcyr — rupantara scaffold smoke (M0): the library links and the
# version probe matches VERSION (CI's docs job checks the same pair).
include "src/lib.cyr"
include "lib/assert.cyr"

# rupantara_version() packs VERSION as major*10000 + minor*100 + patch
fn test_version() {
    assert_eq(rupantara_version(), 600, "version 0.6.0 packs to 600");
    return 0;
}

# runs the suite; the exit code is the failure count
fn main(): i64 {
    alloc_init();
    test_version();
    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
