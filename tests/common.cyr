# tests/common.cyr — helpers shared by the tests/tcyr suites and the fuzz harness:
# f64 tolerances, deterministic fills, a seeded PRNG, and sentinel fills for the
# "a rejected call writes nothing" checks. Included after src/lib.cyr. Not a suite.

# |a - b| < tol (absolute; f64 near-equality)
fn f64_close(a, b, tol): i64 {
    var d = f64_sub(a, b);
    if (f64_lt(d, f64_from(0))) { d = f64_sub(f64_from(0), d); }
    if (f64_lt(d, tol)) { return 1; }
    return 0;
}

# |a - b| <= tol * max(1, |b|) (relative, floored at 1 for values near 0)
fn f64_close_rel(a, b, tol): i64 {
    var mag = b;
    if (f64_lt(mag, f64_from(0))) { mag = f64_sub(f64_from(0), mag); }
    if (f64_lt(mag, f64_from(1))) { mag = f64_from(1); }
    return f64_close(a, b, f64_mul(tol, mag));
}

# 10^-k as f64, for k in 2..12
fn tol_pow10(k): i64 {
    var d = 1;
    var i = 0;
    while (i < k) { d = d * 10; i = i + 1; }
    return f64_div(f64_from(1), f64_from(d));
}
# 1e-2
fn tol_1e2(): i64 { return tol_pow10(2); }
# 1e-3
fn tol_1e3(): i64 { return tol_pow10(3); }
# 1e-6
fn tol_1e6(): i64 { return tol_pow10(6); }
# 1e-9
fn tol_1e9(): i64 { return tol_pow10(9); }

# deterministic fill in [-1, 1] with a per-buffer salt (no PRNG; varied values whose
# products are not exactly representable, so a reordered sum shows in the low bits)
fn fill_det(p, n, salt): i64 {
    var i = 0;
    while (i < n) {
        var m = ((i + salt) * 37 + 11) % 101 - 50;
        store64(p + i * 8, f64_div(f64_from(m), f64_from(50)));
        i = i + 1;
    }
    return 0;
}

# ---- seeded PRNG: splitmix64 (Steele, Lea, Flood 2014) -----------------------
var _cm_rng = 0;

# seed the PRNG (every seed, 0 included, gives a full-period stream)
fn rng_seed64(s): i64 { _cm_rng = s; return 0; }

# next 64-bit output
fn rng_next64(): i64 {
    _cm_rng = _cm_rng + 0x9E3779B97F4A7C15;
    var z = _cm_rng;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    return z ^ (z >> 31);
}

# uniform integer in [0, n) (n >= 1); 0 for n <= 1
fn rng_below(n): i64 {
    if (n <= 1) { return 0; }
    var r = (rng_next64() >> 1) & 0x3FFFFFFFFFFFFFFF;
    return r % n;
}

# uniform f64 in [-1, 1) on a 2^20 grid, with an occasional edge value: +0, -0, a
# subnormal, or a large magnitude (no NaN / Inf, whose propagation the bit compares
# would only re-test)
fn rng_val(): i64 {
    var k = rng_below(64);
    if (k == 0) { return 0; }
    if (k == 1) { return 0x8000000000000000; }
    if (k == 2) { return rng_below(4503599627370496) + 1; }
    if (k == 3) { return f64_from(rng_below(2000) - 1000); }
    return f64_div(f64_from(rng_below(2097152) - 1048576), f64_from(1048576));
}

# fill n f64 with rng_val()
fn fill_rng(p, n): i64 {
    var i = 0;
    while (i < n) { store64(p + i * 8, rng_val()); i = i + 1; }
    return 0;
}

# ---- sentinels: prove a rejected call wrote nothing -------------------------
fn SENTINEL(): i64 { return 0x5A5AA5A55A5AA5A5; }

# fill n slots with SENTINEL()
fn fill_sentinel(p, n): i64 {
    var i = 0;
    while (i < n) { store64(p + i * 8, SENTINEL()); i = i + 1; }
    return 0;
}

# 1 when all n slots still hold SENTINEL()
fn sentinel_intact(p, n): i64 {
    var i = 0;
    while (i < n) {
        if (load64(p + i * 8) != SENTINEL()) { return 0; }
        i = i + 1;
    }
    return 1;
}

# count of the n slots where the raw 64-bit patterns of a and b differ
fn bits_diff(a, b, n): i64 {
    var d = 0;
    var i = 0;
    while (i < n) {
        if (load64(a + i * 8) != load64(b + i * 8)) { d = d + 1; }
        i = i + 1;
    }
    return d;
}

# fill n slots with a NaN pattern: "dirty" scratch that any read-before-write would
# carry into the outputs
fn fill_dirty(p, n): i64 {
    var i = 0;
    while (i < n) { store64(p + i * 8, 0x7FF8DEADBEEF0001 + i); i = i + 1; }
    return 0;
}
