# rupantara.cyr -- bundled distribution
# Version: 0.5.2
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/rupantara.deps):
include "lib/math.cyr"
include "lib/ganita.cyr"

# --- guard.cyr ---

# @public — rupantara argument guards: the error codes the model-level entry points
# return, and overflow-checked size arithmetic for the sizing functions.
#
# THE CONTRACT (0.5.2). The model-level entries — ru_model_fwd(_s), ru_model_fwd_row(_s),
# ru_attn_fwd — and the sizing functions validate what they are handed before they
# write anything: a malformed config, a token id outside [0, V) or a decode position
# outside [0, T) returns a negative code below and leaves every output untouched. The
# leaf kernels (ru_ln_fwd, ru_gelu_fwd, ru_attn_core_fwd, ru_mlp_fwd, ru_head_fwd*,
# ru_softmax_fwd, ru_embed_fwd) take caller buffers and dims on trust, as rosnet's do:
# no checks, so the hot loops pay nothing. See docs/api.md.
#
# Constants are functions (rosnet's style), not `const`: the bundle stays compilable by
# consumers pinned to cyrius releases older than the 6.7 `const` keyword.

# Success.
fn RU_OK(): i64 { return 0; }
# A malformed config: a dim < 1 (NL < 0), C % nh != 0, nh % nkv != 0, attn_bias not 0/1,
# or a buffer size that would pass _RU_MAX_ELEMS() (it would wrap an i64 byte count).
fn RU_ERR_CFG(): i64 { return -1; }
# A token id outside [0, V).
fn RU_ERR_TOKEN(): i64 { return -2; }
# A decode position outside [0, T) — past the KV cache and the learned position table.
fn RU_ERR_POS(): i64 { return -3; }
# An unsupported option or a null buffer (pos_kind != 0, V < 1 to ru_argmax, a 0 pointer).
fn RU_ERR_ARG(): i64 { return -4; }

# The largest element count any rupantara buffer may need: 2^56 f64 (2^59 bytes). Far
# past any real model, and low enough that a count times 8 bytes cannot wrap an i64.
fn _RU_MAX_ELEMS(): i64 { return 72057594037927936; }

# a * b, or -1 when either is negative or the product passes _RU_MAX_ELEMS(). Chains:
# a -1 operand propagates.
fn _ru_mulc(a, b): i64 {
    if (a < 0 || b < 0) { return -1; }
    if (b != 0 && a > _RU_MAX_ELEMS() / b) { return -1; }
    return a * b;
}

# a + b, or -1 when either is negative or the sum passes _RU_MAX_ELEMS().
fn _ru_addc(a, b): i64 {
    if (a < 0 || b < 0) { return -1; }
    if (a > _RU_MAX_ELEMS() - b) { return -1; }
    return a + b;
}

# 1 when (T, C, nh, nkv) is an attention shape the kernels can index: every dim >= 1,
# C divisible by nh (whole heads) and nh divisible by nkv (whole GQA groups, so the
# head -> K/V-head map h / (nh / nkv) stays inside the nkv K/V heads). 0 otherwise.
fn _ru_attn_dims_ok(T, C, nh, nkv): i64 {
    if (T < 1 || C < 1 || nh < 1 || nkv < 1) { return 0; }
    if (C % nh != 0) { return 0; }
    if (nh % nkv != 0) { return 0; }
    return 1;
}

# Checked element count of the forward attention arena (see ru_attn_arena_size), or -1.
fn _ru_arena_c(T, C, nh, nkv): i64 {
    var Ckv = nkv * (C / nh);
    var s = _ru_mulc(2, _ru_mulc(T, C));
    s = _ru_addc(s, _ru_mulc(2, _ru_mulc(T, Ckv)));
    return _ru_addc(s, _ru_mulc(nh, _ru_mulc(T, T)));
}

# --- norm.cyr ---

# @public — LayerNorm forward. Ported bit-identical from attn11 `ops.cyr:ru_ln_fwd`
# (the GPU fast-path removed; rupantara is CPU-f64). Names kept identical so the
# eventual attn11 re-point is a clean drop-in (extract-and-re-fold).
#
# LayerNorm over the last dim. x,y: (M,C). gamma,beta: (C). Caches mean(M) and
# rstd(M) = 1/sqrt(var+eps), eps = 1e-5. Classic mean/variance LN.
# Source: Ba, Kiros, Hinton (2016), "Layer Normalization", arXiv:1607.06450.

# eps built from an integer ratio (long-digit float literals mis-parse).
fn _ru_eps_ln(): i64 { return f64_div(f64_from(1), f64_from(100000)); }   # 1e-5

# y = (x - mean) * rstd * gamma + beta per row of x(M,C); writes mean(M), rstd(M).
# Two passes (mean, then the centred variance), each a sequential sum in index order.
# A leaf kernel: buffers and dims are the caller's (C >= 1; y may alias x).
fn ru_ln_fwd(x, gamma, beta, y, mean, rstd, M, C): i64 {
    var eps = _ru_eps_ln();
    var invC = f64_div(f64_from(1), f64_from(C));
    var m = 0;
    while (m < M) {
        var row = x + m * C * 8;
        var mu = f64_from(0);
        var i = 0;
        while (i < C) { mu = f64_add(mu, load64(row + i * 8)); i = i + 1; }
        mu = f64_mul(mu, invC);
        var v = f64_from(0);
        i = 0;
        while (i < C) {
            var d = f64_sub(load64(row + i * 8), mu);
            v = f64_add(v, f64_mul(d, d));
            i = i + 1;
        }
        v = f64_mul(v, invC);
        var rs = f64_div(f64_from(1), f64_sqrt(f64_add(v, eps)));
        store64(mean + m * 8, mu);
        store64(rstd + m * 8, rs);
        i = 0;
        while (i < C) {
            var xhat = f64_mul(f64_sub(load64(row + i * 8), mu), rs);
            var o = f64_add(f64_mul(xhat, load64(gamma + i * 8)), load64(beta + i * 8));
            store64(y + (m * C + i) * 8, o);
            i = i + 1;
        }
        m = m + 1;
    }
    return 0;
}

# --- act.cyr ---

# @public — GELU forward (tanh approximation, GPT-2 form). Ported bit-identical
# from attn11 `ops.cyr:ru_gelu_fwd` (GPU fast-path removed). Name kept identical.
#
#   g(x) = 0.5 * x * (1 + tanh( c*(x + a*x^3) )),  c = sqrt(2/pi), a = 0.044715
# Source: Hendrycks & Gimpel (2016), "Gaussian Error Linear Units", arXiv:1606.08415.

fn _ru_gelu_c(): i64 { return f64_sqrt(f64_div(f64_from(2), F64_PI)); }          # sqrt(2/pi)
fn _ru_gelu_a(): i64 { return f64_div(f64_from(44715), f64_from(1000000)); }     # 0.044715

# y[i] = gelu(x[i]) for i < n (the tanh form above). A leaf kernel: y may alias x.
fn ru_gelu_fwd(x, y, n): i64 {
    var c = _ru_gelu_c();
    var a = _ru_gelu_a();
    var half = f64_div(f64_from(1), f64_from(2));
    var one = f64_from(1);
    var i = 0;
    while (i < n) {
        var xv = load64(x + i * 8);
        var x3 = f64_mul(f64_mul(xv, xv), xv);
        var inner = f64_mul(c, f64_add(xv, f64_mul(a, x3)));
        var t = f64_tanh(inner);
        store64(y + i * 8, f64_mul(f64_mul(half, xv), f64_add(one, t)));
        i = i + 1;
    }
    return 0;
}

# --- attn.cyr ---

# @public — causal multi-head self-attention FORWARD. Ported bit-identical from
# attn11 `src/attn.cyr` (ru_attn_core_fwd + ru_attn_fwd), with the training-only paths
# removed: no GPU fast-path, no bidirectional (diffusion) mask, no RoPE branch
# (M1 is learned-absolute positions; RoPE is a later increment). Names + the
# per-head arithmetic are kept IDENTICAL to attn11 so the eventual re-point is a
# clean drop-in (extract-and-re-fold).
#
# Source: Vaswani et al. (2017), "Attention Is All You Need", arXiv:1706.03762 —
# scaled dot-product attention: score = (Q·K)/sqrt(hd), softmax, multi-head split.
# Grouped-query attention (nkv < nh): Ainslie et al. (2023), arXiv:2305.13245;
# multi-query (nkv == 1): Shazeer (2019), arXiv:1911.02150.
#
# Single sequence of length T, embedding width C, nh query heads, head dim
# hd = C/nh, and nkv K/V heads (nkv divides nh; nkv == nh is classic MHA).
# Q/O projections are C x C; K/V projections are C x Ckv where Ckv = nkv*hd —
# each group of gsz = nh/nkv query heads shares one K/V head. Query heads occupy
# contiguous column blocks [h*hd, (h+1)*hd) of the (T,C) Q/concat tensors; K/V
# head g occupies [g*hd, (g+1)*hd) of the (T,Ckv) K/V.

# ---- forward-only attention arena -------------------------------------------
# The forward caches live in one pre-allocated arena (fixed shapes). Layout — the
# FIRST five regions of attn11's arena, in the SAME order, so the sub-pointer math
# below is byte-identical to attn11's (attn11's full arena, which also carries the
# backward temporaries, drops straight into ru_attn_fwd here). rupantara is
# forward-only, so it sizes just these five:
#   Qc       : T*C
#   Kc Vc    : T*Ckv each
#   Pc       : nh*T*T   (attention probabilities, causal-masked)
#   concat   : T*C      (pre-Wo head concatenation)
# Returns the element count, or RU_ERR_CFG() (-1) for a shape the kernels cannot index
# (a dim < 1, C % nh != 0, nh % nkv != 0) or one whose arena would pass
# _RU_MAX_ELEMS() — so t_alloc refuses it loudly instead of a wrapped size coming back
# small (it divided by zero at nh = 0 and wrapped silently through 0.5.1).
fn ru_attn_arena_size(T, C, nh, nkv): i64 {
    if (_ru_attn_dims_ok(T, C, nh, nkv) == 0) { return RU_ERR_CFG(); }
    return _ru_arena_c(T, C, nh, nkv);
}

# arena sub-pointers (deterministic given dims; Ckv = nkv * (C/nh)) — identical to
# attn11's _ru_at_Qc.._ru_at_concat (these regions come first, so the offsets match
# regardless of whether the backward temporaries follow).
fn _ru_at_Qc(ar): i64 { return ar; }
fn _ru_at_Kc(ar, T, C): i64 { return ar + (T * C) * 8; }
fn _ru_at_Vc(ar, T, C, Ckv): i64 { return ar + (T * C + T * Ckv) * 8; }
fn _ru_at_Pc(ar, T, C, Ckv): i64 { return ar + (T * C + 2 * T * Ckv) * 8; }
fn _ru_at_concat(ar, T, C, nh, Ckv): i64 { return ar + (T * C + 2 * T * Ckv + nh * T * T) * 8; }

# ---- one (query head, query position) pair: THE per-head arithmetic -----------
# The single source of truth for both attention cores (the batch ru_attn_core_fwd
# below and the cached-decode ru_attn_core_fwd_row in decode.cyr), so cached decode is
# bit-identical to the batch forward by construction, not by two copies kept in step
# (through 0.5.1 they were two ~45-line copies).
#   qbase : this query head's hd-block of its Q row
#   Kc/Vc : (>= jhi+1, Ckv) key / value rows; kvb = this head's shared K/V head offset
#   prow  : jhi+1 f64 out — the softmax probabilities over keys 0..jhi
#   cbase : hd f64 out — sum_j prow[j] * V[j, kvb..kvb+hd)
# Scores: a 4-lane f64v_fmadd dot over the head dim, the lanes tree-reduced, then the
# 0..3-element scalar tail; times scale = 1/sqrt(hd). Softmax: max-subtracted exp,
# one division, scaled. PV: one f64v_axpy per key over the 4-aligned body (0.5.2),
# then the same scalar tail. The axpy replaced a broadcast-buffer fill plus one
# f64v_fmadd per 4 elements: each element still gets round(round(p*v) + acc) in
# ascending-j order (mulpd + addpd on x86_64; FMLA on aarch64, where f64v_fmadd also
# fuses), and the vector/scalar split stays at hd4 — rosnet ADR 0002's rule, the same
# change rosnet 1.2.2 made to linear_fwd. Bit-identical to 0.5.1 (tests/tcyr/reference.tcyr).
fn _ru_attn_qrow(qbase, Kc, Vc, prow, cbase, jhi, Ckv, kvb, hd, scale): i64 {
    var hd4 = hd - (hd % 4);        # head dim is contiguous -> 4-wide vector body
    var acc[32];                    # 4-lane dot accumulator (fn-local: 32 bytes = 4 f64)
    # raw scores for keys j = 0..jhi
    var j = 0;
    while (j <= jhi) {
        var kbase = Kc + (j * Ckv + kvb) * 8;
        store64(&acc, f64_from(0)); store64(&acc + 8, f64_from(0));
        store64(&acc + 16, f64_from(0)); store64(&acc + 24, f64_from(0));
        var d = 0;
        while (d < hd4) {
            f64v_fmadd(&acc, qbase + d * 8, kbase + d * 8, &acc, 4);
            d = d + 4;
        }
        var dot = f64_add(f64_add(load64(&acc), load64(&acc + 8)),
          f64_add(load64(&acc + 16), load64(&acc + 24)));
        while (d < hd) {
            dot = f64_add(dot, f64_mul(load64(qbase + d * 8), load64(kbase + d * 8)));
            d = d + 1;
        }
        store64(prow + j * 8, f64_mul(dot, scale));
        j = j + 1;
    }
    # softmax over j = 0..jhi
    var mx = load64(prow);
    j = 1;
    while (j <= jhi) {
        var s = load64(prow + j * 8);
        if (f64_gt(s, mx) == 1) { mx = s; }
        j = j + 1;
    }
    var sum = f64_from(0);
    j = 0;
    while (j <= jhi) {
        var e = f64_exp(f64_sub(load64(prow + j * 8), mx));
        store64(prow + j * 8, e);
        sum = f64_add(sum, e);
        j = j + 1;
    }
    var inv = f64_div(f64_from(1), sum);
    j = 0;
    while (j <= jhi) { store64(prow + j * 8, f64_mul(load64(prow + j * 8), inv)); j = j + 1; }
    # cbase[d] = sum_j P[j] * V[j, kvb+d]: an axpy over the contiguous head dim per key
    var dz = 0;
    while (dz < hd) { store64(cbase + dz * 8, f64_from(0)); dz = dz + 1; }
    j = 0;
    while (j <= jhi) {
        var pij = load64(prow + j * 8);
        var vbase = Vc + (j * Ckv + kvb) * 8;
        f64v_axpy(cbase, vbase, pij, hd4);       # hd4 is a multiple of 4: no tail past cbase
        var d = hd4;
        while (d < hd) {
            store64(cbase + d * 8, f64_add(load64(cbase + d * 8),
                f64_mul(pij, load64(vbase + d * 8))));
            d = d + 1;
        }
        j = j + 1;
    }
    return 0;
}

# ---- shared attention core (post-projection) --------------------------------
# Given Qc(T,C), Kc(T,Ckv), Vc(T,Ckv) it fills Pc(nh,T,T) and concat(T,C): causal
# scaled-dot-product, each query head h attending its shared K/V head
# kvb = (h/gsz)*hd, query i attending keys 0..i. The per-pair arithmetic is
# _ru_attn_qrow above. A leaf kernel: dims are trusted (C % nh == 0 and nh % nkv == 0
# are the caller's — the model entries check them; see src/guard.cyr).
fn ru_attn_core_fwd(Qc, Kc, Vc, Pc, concat, T, C, nh, nkv): i64 {
    var hd = C / nh;
    var Ckv = nkv * hd;
    var gsz = nh / nkv;             # query heads per K/V head (GQA group size)
    var scale = f64_div(f64_from(1), f64_sqrt(f64_from(hd)));

    # zero the full probability buffer (upper triangle stays 0)
    t_zero(Pc, nh * T * T);

    var h = 0;
    while (h < nh) {
        var base = h * hd;          # this query head's block in Q/concat
        var kvb = (h / gsz) * hd;   # its shared K/V head's block in Kc/Vc
        var i = 0;
        while (i < T) {
            _ru_attn_qrow(Qc + (i * C + base) * 8, Kc, Vc, Pc + (h * T + i) * T * 8,
              concat + (i * C + base) * 8, i, Ckv, kvb, hd, scale);
            i = i + 1;
        }
        h = h + 1;
    }
    return 0;
}

# ---- forward (MHA / GQA) ----------------------------------------------------
# x(T,C) -> out(T,C). Projects Q/K/V, runs the shared core, applies Wo. Bias
# pointers bq/bk/bv/bo may be 0. pos_kind is carried for signature parity with
# attn11; only 0 (learned-absolute) is implemented — RoPE (1) is a later increment.
# rupantara uses rosnet's linear_fwd directly (attn11's qlinear_fwd is a pure
# passthrough to it off the ternary path, so this is bit-identical).
# Returns 0, RU_ERR_ARG() for pos_kind != 0 (through 0.5.1 a RoPE request silently ran
# learned-absolute attention), or RU_ERR_CFG() for a shape the core cannot index —
# both before anything is written. ar must hold ru_attn_arena_size(T, C, nh, nkv) f64.
fn ru_attn_fwd(Wq, bq, Wk, bk, Wv, bv, Wo, bo, x, out, ar, T, C, nh, nkv, pos_kind): i64 {
    if (pos_kind != 0) { return RU_ERR_ARG(); }
    if (_ru_attn_dims_ok(T, C, nh, nkv) == 0) { return RU_ERR_CFG(); }
    var Ckv = nkv * (C / nh);
    var Qc = _ru_at_Qc(ar);
    var Kc = _ru_at_Kc(ar, T, C);
    var Vc = _ru_at_Vc(ar, T, C, Ckv);
    var Pc = _ru_at_Pc(ar, T, C, Ckv);
    var concat = _ru_at_concat(ar, T, C, nh, Ckv);
    linear_fwd(x, Wq, bq, Qc, T, C, C);
    linear_fwd(x, Wk, bk, Kc, T, C, Ckv);
    linear_fwd(x, Wv, bv, Vc, T, C, Ckv);
    ru_attn_core_fwd(Qc, Kc, Vc, Pc, concat, T, C, nh, nkv);
    linear_fwd(concat, Wo, bo, out, T, C, C);
    return 0;
}

# --- mlp.cyr ---

# @public — position-wise MLP FORWARD (GELU, GPT-2 form). Ported from attn11's
# inline dense-MLP forward (`src/model.cyr` model_forward: qlinear_fwd -> ru_gelu_fwd
# -> qlinear_fwd). rupantara uses rosnet's linear_fwd directly (attn11's
# qlinear_fwd is a passthrough to it off the ternary path — bit-identical).
#
#   fc  = x  @ Wfc  + bfc      (M,C) @ (C,F) -> (M,F)
#   gg  = gelu(fc)             elementwise, M*F
#   y   = gg @ Wproj + bproj   (M,F) @ (F,C) -> (M,C)
#
# fc/gg are caller-provided scratch (M*F f64 each), mirroring attn11's LA_fc/LA_g.
# Biases bfc/bproj may be 0.
fn ru_mlp_fwd(x, Wfc, bfc, Wproj, bproj, fc, gg, y, M, C, F): i64 {
    linear_fwd(x, Wfc, bfc, fc, M, C, F);
    ru_gelu_fwd(fc, gg, M * F);
    linear_fwd(gg, Wproj, bproj, y, M, F, C);
    return 0;
}

# --- gpu.cyr ---

# src/gpu.cyr — rupantara GPU offload of the f64 projection matmul (AGNOS gfx90c).
#
# linear_fwd_gpu(x, W, b, y, M, K, N) is a BIT-IDENTICAL peer of rosnet linear_fwd that runs the matmul on the
# AMD Cezanne gfx90c shader cores via the agnos ring-3 syscall #83 (gpu_dispatch_f64), one 8x8x8 tile per
# call, gathering the strided sub-blocks on the CPU side and accumulating nothing across tiles (single k-tile).
#
# WHY IT IS BIT-IDENTICAL (not merely close) for the bias-free, K<=8 case:
#   - the #83 shader computes C = A*B with UNFUSED v_mul_f64 then v_add_f64, k-ascending (kernel-fidelity
#     proven: gpu_shader_dispatch_f64_fidelity, which diverges from a fused FMA on rounding data);
#   - rosnet linear_fwd's f64 body is one packed f64v_axpy per row step (1.2.2+; f64v_fmadd before), which on
#     x86 is mulpd + addpd (SSE2 has NO hardware FMA) — ALSO unfused, two roundings, k-ascending (rosnet ADR
#     0002 holds every kernel optimization to the same rounding sequence);
#   - so per element both compute round(round(x_k*W_kj) + acc) in the same order => same bits.
#   K<=8 means a SINGLE k-tile, so there is no cross-tile f64 accumulation to reorder. Bias MUST be 0:
#   linear_fwd seeds y with the bias as the FIRST addend, so adding a bias after the GPU sum would change the
#   association. K>8 or a bias hands the whole problem to the CPU peer (bit-exact by construction); a GPU
#   path for them needs cross-tile accumulation in linear_fwd's order (docs/development/roadmap.md, Follow-ons).
#
# PORTABILITY / SAFETY: the #83 dispatch is compiled ONLY under CYRIUS_TARGET_AGNOS. On any other target, or
# when #83 returns < 0 (no GPU, or the boot self-test left gpu_matmul_f64_ok unproven — the normal QEMU
# answer), each tile falls back to rosnet linear_fwd on the gathered 8x8 blocks, so the RESULT is identical
# either way and the gather/scatter arithmetic is exercisable off-hardware. ONE target caveat (found by the
# 0.5.2 audit): the padded 8-column fallback tile runs every column through linear_fwd's packed body, while
# the full problem runs its last N % 4 columns through the scalar tail. Those round alike on x86_64 (the
# GPU target), but on aarch64 the packed body is a fused FMLA, so there a ragged final tile's last N % 4
# columns can differ from linear_fwd by that rounding (pinned in tests/tcyr/gpu.tcyr). A wrong dispatch never silently
# corrupts a caller: the accompanying proof (programs/gpulayer.cyr) byte-compares against linear_fwd.
# Returns the number of tiles that executed on the GPU (0 = full CPU fallback, e.g. QEMU).

# Tile scratch (module-global ⇒ N x u64 = 8N bytes): A,B,C are 8x8 f64 = 64 each; zbias is an 8-f64 zero.
var lfg_a[64];
var lfg_b[64];
var lfg_c[64];
var lfg_zbias[8];

# Full CPU delegation for shapes the 8x8 tile path cannot represent (K > 8, or a
# non-zero bias). Returns 0 = "no tile ran on the GPU", this file's existing contract.
fn linear_fwd_gpu_cpu_peer(x, W, b, y, M, K, N): i64 {
    linear_fwd(x, W, b, y, M, K, N);
    return 0;
}

# y(M,N) = x(M,K) @ W(K,N) + b, bit-identical to rosnet linear_fwd. Runs 8x8x8 tiles on
# the AGNOS GPU (#83) when K <= 8 and b == 0, else on the CPU (see the header). Returns
# the number of tiles the GPU ran. NOT reentrant: the tile scratch above is module-global,
# so two threads must not call it at once.
fn linear_fwd_gpu(x, W, b, y, M, K, N): i64 {
    # SELF-FALLBACK. The tile path below gathers a FIXED 8x8 block (`kk < 8`, `kr < 8`)
    # with no k-tile loop, and substitutes `lfg_zbias` for `b`. So it can only represent
    # K <= 8 with no bias. Handed anything else it used to compute a WRONG answer
    # silently: K>8 dropped elements k=8..K-1 from the contraction, and a non-zero `b`
    # vanished entirely on every target. Both shapes now delegate the whole problem to
    # the CPU peer and report 0 GPU tiles — which is already this function's documented
    # meaning for "full CPU fallback". Pinned by test_gpu_self_fallback in
    # tests/tcyr/gpu.tcyr, which compares against linear_fwd element by element.
    if (K > 8) { return linear_fwd_gpu_cpu_peer(x, W, b, y, M, K, N); }
    if (b != 0) { return linear_fwd_gpu_cpu_peer(x, W, b, y, M, K, N); }

    # zero-bias vector for the CPU-fallback linear_fwd (this path is bias-free by contract; b is ignored).
    var z = 0;
    while (z < 8) { store64(&lfg_zbias + z * 8, f64_from(0)); z = z + 1; }

    var gpu_tiles = 0;
    var mt = 0;
    while (mt < M) {
        var nt = 0;
        while (nt < N) {
            # Gather the 8xK x-block (rows mt.., cols 0..K) into lfg_a as row-major 8x8, zero-padded.
            var i = 0;
            while (i < 8) {
                var kk = 0;
                while (kk < 8) {
                    var av = f64_from(0);
                    if (i < M - mt) { if (kk < K) { av = load64(x + ((mt + i) * K + kk) * 8); } }
                    store64(&lfg_a + (i * 8 + kk) * 8, av);
                    kk = kk + 1;
                }
                i = i + 1;
            }
            # Gather the Kx8 W-block (rows 0..K, cols nt..) into lfg_b as row-major 8x8, zero-padded.
            var kr = 0;
            while (kr < 8) {
                var j = 0;
                while (j < 8) {
                    var bv = f64_from(0);
                    if (kr < K) { if (j < N - nt) { bv = load64(W + (kr * N + nt + j) * 8); } }
                    store64(&lfg_b + (kr * 8 + j) * 8, bv);
                    j = j + 1;
                }
                kr = kr + 1;
            }

            # Dispatch on the GPU; fall back to CPU linear_fwd on the tile when unavailable.
            var used_gpu = 0;
            #ifdef CYRIUS_TARGET_AGNOS
            if (syscall(83, &lfg_a, &lfg_b, &lfg_c) == 0) { used_gpu = 1; }
            #endif
            if (used_gpu == 0) { linear_fwd(&lfg_a, &lfg_b, &lfg_zbias, &lfg_c, 8, 8, 8); }
            else { gpu_tiles = gpu_tiles + 1; }

            # Scatter the 8x8 C-tile back into y (rows mt.., cols nt..), clipped to M,N.
            var ii = 0;
            while (ii < 8) {
                if (ii < M - mt) {
                    var jj = 0;
                    while (jj < 8) {
                        if (jj < N - nt) {
                            store64(y + ((mt + ii) * N + nt + jj) * 8, load64(&lfg_c + (ii * 8 + jj) * 8));
                        }
                        jj = jj + 1;
                    }
                }
                ii = ii + 1;
            }
            nt = nt + 8;
        }
        mt = mt + 8;
    }
    return gpu_tiles;
}

# --- embed.cyr ---

# @public — input embedding FORWARD: token lookup + learned ABSOLUTE positional
# embedding. Ported from attn11 `src/model.cyr:embed_fwd_n` (the AR / learned-abs
# path — no RoPE, no diffusion [MASK] embedding; those are attn11 training concerns
# outside rupantara's forward scope). rupantara takes explicit pointers instead of
# reading attn11's model globals.
#
#   x0[t, c] = tok_emb[tokens[t], c] + pos_emb[t, c]
#
# tokens: n integer ids. tok_emb: (V,C). pos_emb: (T,C). x0: (n,C) output (the
# residual stream at layer 0). n <= T (eval windows may be shorter than context).
# A leaf kernel: token ids are trusted (each must be in [0, V) — ru_model_fwd checks).
fn ru_embed_fwd(tokens, tok_emb, pos_emb, x0, n, C): i64 {
    var t = 0;
    while (t < n) {
        var tok = load64(tokens + t * 8);
        _ru_add_rows(x0 + t * C * 8, tok_emb + tok * C * 8, pos_emb + t * C * 8, C);
        t = t + 1;
    }
    return 0;
}

# dst[i] = a[i] + b[i] for i < n — the embedding sum and every residual add in the
# block and decode paths. f64v_add over the even prefix (the builtins write whole
# 2-lane pairs and have no scalar tail, so the count passed must be even), then the
# odd last element alone. One rounding per element on every target, in the same
# operand order as the scalar loops it replaced (0.5.2), so the bits are unchanged.
# dst may alias a or b.
fn _ru_add_rows(dst, a, b, n): i64 {
    var n2 = n - (n % 2);
    f64v_add(dst, a, b, n2);
    var i = n2;
    while (i < n) {
        store64(dst + i * 8, f64_add(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return 0;
}

# --- head.cyr ---

# @public — weight-tied LM head + softmax FORWARD. Ported bit-identical from
# attn11 `src/model.cyr:ru_head_fwd_row` (the same 4-lane SIMD dot + tree reduction)
# and the probability half of `src/ops.cyr:softmax_xent_fwd`. attn11 reads its
# model globals (g_C/g_V/P_tokemb); rupantara takes explicit pointers/dims.
#
# WEIGHT TYING: the output unembed IS the token embedding — logits[v] = f · tok_emb[v]
# (Press & Wolf 2017 arXiv:1608.05859; Inan et al. 2017 arXiv:1611.01462).

# logits_row(V) = f_row(C) @ tok_emb^T — one row. tok_emb: (V,C) row-major.
fn ru_head_fwd_row(f_row, tok_emb, logits_row, C, V): i64 {
    var c4 = C - (C % 4);
    var acc[32];                     # 4-lane dot accumulator (SIMD head)
    var v = 0;
    while (v < V) {
        var erow = tok_emb + v * C * 8;
        store64(&acc, f64_from(0)); store64(&acc + 8, f64_from(0));
        store64(&acc + 16, f64_from(0)); store64(&acc + 24, f64_from(0));
        var c = 0;
        while (c < c4) {
            f64v_fmadd(&acc, f_row + c * 8, erow + c * 8, &acc, 4);
            c = c + 4;
        }
        var dot = f64_add(f64_add(load64(&acc), load64(&acc + 8)),
          f64_add(load64(&acc + 16), load64(&acc + 24)));
        while (c < C) {
            dot = f64_add(dot, f64_mul(load64(f_row + c * 8), load64(erow + c * 8)));
            c = c + 1;
        }
        store64(logits_row + v * 8, dot);
        v = v + 1;
    }
    return 0;
}

# logits(n,V) = f(n,C) @ tok_emb^T over the first n rows. attn11 loops ru_head_fwd_row
# the same way (head_fwd_n), so the batch and cached-decode paths share arithmetic.
fn ru_head_fwd(f, tok_emb, logits, n, C, V): i64 {
    var t = 0;
    while (t < n) {
        ru_head_fwd_row(f + t * C * 8, tok_emb, logits + t * V * 8, C, V);
        t = t + 1;
    }
    return 0;
}

# Row-wise softmax over logits(M,V) -> probs(M,V). Max-subtraction for numerical
# stability, then normalize. Bit-identical to the probability output of attn11's
# softmax_xent_fwd (Goodfellow, Bengio, Courville 2016, §4.1/§6.2) — the
# cross-entropy loss/target half stays in attn11 (training).
fn ru_softmax_fwd(logits, probs, M, V): i64 {
    var m = 0;
    while (m < M) {
        var row = logits + m * V * 8;
        var prow = probs + m * V * 8;
        # max for numerical stability
        var mx = load64(row);
        var i = 1;
        while (i < V) {
            var lv = load64(row + i * 8);
            if (f64_gt(lv, mx) == 1) { mx = lv; }
            i = i + 1;
        }
        var sum = f64_from(0);
        i = 0;
        while (i < V) {
            var e = f64_exp(f64_sub(load64(row + i * 8), mx));
            store64(prow + i * 8, e);
            sum = f64_add(sum, e);
            i = i + 1;
        }
        var inv = f64_div(f64_from(1), sum);
        i = 0;
        while (i < V) {
            store64(prow + i * 8, f64_mul(load64(prow + i * 8), inv));
            i = i + 1;
        }
        m = m + 1;
    }
    return 0;
}

# --- blocks.cyr ---

# @public — rupantara transformer-forward composition: the pre-norm block and the
# block-stack forward, assembled from the leaf/core ops (norm/act/attn/mlp/embed/
# head). Ported from attn11 `src/model.cyr` (embed_fwd_n / _attn_block_fwd /
# model_forward), but WITHOUT attn11's model singleton — the model lives in a
# caller-owned packed parameter buffer + a small i64 config descriptor, so a
# consumer runs a transformer with no attn11 global state.
#
# Architecture: a pre-norm decoder-only Transformer (Vaswani et al. 2017,
# arXiv:1706.03762; pre-norm placement per Xiong et al. 2020, arXiv:2002.04745;
# GPT-2, Radford et al. 2019). M1 scope: MHA/GQA, learned-absolute positions,
# dense GELU MLP, LayerNorm, weight-tied LM head. No dropout — this is the
# inference forward (attn11's dropout is the identity in eval, so bit-identical).
#
# PACKED PARAMETER LAYOUT (element offsets) — byte-identical to attn11's MHA/dense
# layout, so attn11's g_params can feed ru_model_fwd directly (the parity contract):
#   [ tok_emb (V*C) ][ pos_emb (T*C) ][ block_0 ]...[ block_{NL-1} ][ lnf_g (C) ][ lnf_b (C) ]
# Each block (no attn bias):
#   ln1_g(C) ln1_b(C) Wq(C*C) Wk(C*Ckv) Wv(C*Ckv) Wo(C*C)
#   ln2_g(C) ln2_b(C) Wfc(C*F) bfc(F) Wproj(F*C) bproj(C)
# With attn bias, bq(C) bk(Ckv) bv(Ckv) bo(C) are appended after the base block
# (Ckv = nkv*(C/nh)); the base weight offsets are unchanged.

# Packed version int: major*10000 + minor*100 + patch (0.5.2 -> 502).
# NOTE: this constant sat at 400 through the whole of 0.4.1 — the 0.4.1 cut moved VERSION
# and the CHANGELOG but not this function, and tests/tcyr/smoke.tcyr asserted the stale
# value with a message naming 0.4.0, so the gate confirmed the bug instead of catching it.
# It drifted again through 0.4.3 (still 402). CI's docs job now checks it against VERSION.
# Bump BOTH on every cut.
fn rupantara_version(): i64 {
    return 502;
}

# ---- config descriptor (8 i64) ---------------------------------------------
# A caller-owned i64[8]: V, C, T, nh, nkv, NL, F, attn_bias. F is explicit (GPT-2
# uses 4*C) so a consumer with a different MLP ratio is not forced to 4*C. Stores the
# fields as given; ru_cfg_check validates them (every model entry runs it).
fn ru_cfg_init(cfg, V, C, T, nh, nkv, NL, F, attn_bias): i64 {
    store64(cfg, V);
    store64(cfg + 8, C);
    store64(cfg + 16, T);
    store64(cfg + 24, nh);
    store64(cfg + 32, nkv);
    store64(cfg + 40, NL);
    store64(cfg + 48, F);
    store64(cfg + 56, attn_bias);
    return 0;
}
fn _cfg_V(cfg): i64 { return load64(cfg); }
fn _cfg_C(cfg): i64 { return load64(cfg + 8); }
fn _cfg_T(cfg): i64 { return load64(cfg + 16); }
fn _cfg_nh(cfg): i64 { return load64(cfg + 24); }
fn _cfg_nkv(cfg): i64 { return load64(cfg + 32); }
fn _cfg_NL(cfg): i64 { return load64(cfg + 40); }
fn _cfg_F(cfg): i64 { return load64(cfg + 48); }
fn _cfg_bias(cfg): i64 { return load64(cfg + 56); }
fn _cfg_Ckv(cfg): i64 { return _cfg_nkv(cfg) * (_cfg_C(cfg) / _cfg_nh(cfg)); }

# 0 (RU_OK) when cfg describes a model every rupantara buffer and index can represent,
# else RU_ERR_CFG (-1). Checks: cfg != 0; V, C, T, nh, nkv, F >= 1 and NL >= 0;
# C % nh == 0 (whole heads); nh % nkv == 0 (whole GQA groups — nkv <= nh follows);
# attn_bias is 0 or 1; and every buffer the config sizes — the packed params, the
# forward scratch, the KV cache, the decode scratch and the (T, V) logits — stays
# within _RU_MAX_ELEMS(), so no element count or byte offset wraps. Through 0.5.1
# nothing checked: nh = 0 or nkv > nh divided by zero, C % nh != 0 left concat columns
# unwritten, nh % nkv != 0 sent heads past the last K/V head (reads off the end of the
# K/V rows), and attn_bias = 2 sized the block without biases but read them anyway.
fn ru_cfg_check(cfg): i64 {
    if (cfg == 0) { return RU_ERR_CFG(); }
    if (_cfg_V(cfg) < 1 || _cfg_F(cfg) < 1 || _cfg_NL(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_attn_dims_ok(_cfg_T(cfg), _cfg_C(cfg), _cfg_nh(cfg), _cfg_nkv(cfg)) == 0) { return RU_ERR_CFG(); }
    if (_cfg_bias(cfg) != 0 && _cfg_bias(cfg) != 1) { return RU_ERR_CFG(); }
    if (_ru_params_c(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_model_scratch_c(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_decode_kv_c(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_decode_scratch_c(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_mulc(_cfg_T(cfg), _cfg_V(cfg)) < 0) { return RU_ERR_CFG(); }
    return RU_OK();
}

# ---- within-block element offsets (mirror attn11's _o_*) --------------------
fn _ru_o_ln1g(cfg): i64 { return 0; }
fn _ru_o_ln1b(cfg): i64 { return _cfg_C(cfg); }
fn _ru_o_Wq(cfg): i64 { return 2 * _cfg_C(cfg); }
fn _ru_o_Wk(cfg): i64 { var C = _cfg_C(cfg); return 2 * C + C * C; }
fn _ru_o_Wv(cfg): i64 { var C = _cfg_C(cfg); return 2 * C + C * C + C * _cfg_Ckv(cfg); }
fn _ru_o_Wo(cfg): i64 { var C = _cfg_C(cfg); return 2 * C + C * C + 2 * C * _cfg_Ckv(cfg); }
fn _ru_o_ln2g(cfg): i64 { return _ru_o_Wo(cfg) + _cfg_C(cfg) * _cfg_C(cfg); }
fn _ru_o_ln2b(cfg): i64 { return _ru_o_ln2g(cfg) + _cfg_C(cfg); }
fn _ru_o_Wfc(cfg): i64 { return _ru_o_ln2g(cfg) + 2 * _cfg_C(cfg); }
fn _ru_o_bfc(cfg): i64 { return _ru_o_Wfc(cfg) + _cfg_C(cfg) * _cfg_F(cfg); }
fn _ru_o_Wproj(cfg): i64 { return _ru_o_bfc(cfg) + _cfg_F(cfg); }
fn _ru_o_bproj(cfg): i64 { return _ru_o_Wproj(cfg) + _cfg_F(cfg) * _cfg_C(cfg); }

# base block size (no attn bias): 4C + 2C^2 + 2C*Ckv + (2C*F + F + C)
fn _ru_blk_base_size(cfg): i64 {
    var C = _cfg_C(cfg);
    var F = _cfg_F(cfg);
    return 4 * C + 2 * C * C + 2 * C * _cfg_Ckv(cfg) + (2 * C * F + F + C);
}
# attn-bias offsets (present only when enabled), appended after the base block
fn _ru_o_bq(cfg): i64 { return _ru_blk_base_size(cfg); }
fn _ru_o_bk(cfg): i64 { return _ru_blk_base_size(cfg) + _cfg_C(cfg); }
fn _ru_o_bv(cfg): i64 { return _ru_blk_base_size(cfg) + _cfg_C(cfg) + _cfg_Ckv(cfg); }
fn _ru_o_bo(cfg): i64 { return _ru_blk_base_size(cfg) + _cfg_C(cfg) + 2 * _cfg_Ckv(cfg); }
fn _ru_blk(cfg): i64 {
    if (_cfg_bias(cfg) == 1) { return _ru_blk_base_size(cfg) + 2 * _cfg_C(cfg) + 2 * _cfg_Ckv(cfg); }
    return _ru_blk_base_size(cfg);
}
fn _ru_emb_end(cfg): i64 { return _cfg_V(cfg) * _cfg_C(cfg) + _cfg_T(cfg) * _cfg_C(cfg); }
fn _ru_blk_base(cfg, L): i64 { return _ru_emb_end(cfg) + L * _ru_blk(cfg); }

# shared parameter sub-pointers (params is a byte pointer to the packed buffer)
fn _p_tokemb(params): i64 { return params; }
fn _p_posemb(params, cfg): i64 { return params + (_cfg_V(cfg) * _cfg_C(cfg)) * 8; }
fn _p_lnfg(params, cfg): i64 { return params + (_ru_emb_end(cfg) + _cfg_NL(cfg) * _ru_blk(cfg)) * 8; }
fn _p_lnfb(params, cfg): i64 { return _p_lnfg(params, cfg) + _cfg_C(cfg) * 8; }

# attn-bias sub-pointers — 0 (no bias) when disabled, mirroring attn11's P_bq etc.
fn _bq(cfg, pblk): i64 { if (_cfg_bias(cfg) == 0) { return 0; } return pblk + _ru_o_bq(cfg) * 8; }
fn _bk(cfg, pblk): i64 { if (_cfg_bias(cfg) == 0) { return 0; } return pblk + _ru_o_bk(cfg) * 8; }
fn _bv(cfg, pblk): i64 { if (_cfg_bias(cfg) == 0) { return 0; } return pblk + _ru_o_bv(cfg) * 8; }
fn _bo(cfg, pblk): i64 { if (_cfg_bias(cfg) == 0) { return 0; } return pblk + _ru_o_bo(cfg) * 8; }

# Total packed parameter count (elements) — sizes a params buffer for a config. The
# same count as ever for a valid config; RU_ERR_CFG (-1) when ru_cfg_check rejects it
# (through 0.5.1 a huge config could wrap this to a small positive count).
fn ru_params_count(cfg): i64 {
    if (ru_cfg_check(cfg) != 0) { return RU_ERR_CFG(); }
    return _ru_params_c(cfg);
}

# Checked block size: _ru_blk's formula with overflow-checked arithmetic, or -1.
fn _ru_blk_c(cfg): i64 {
    var C = _cfg_C(cfg);
    var F = _cfg_F(cfg);
    var Ckv = _cfg_Ckv(cfg);
    var s = _ru_mulc(4, C);
    s = _ru_addc(s, _ru_mulc(2, _ru_mulc(C, C)));
    s = _ru_addc(s, _ru_mulc(2, _ru_mulc(C, Ckv)));
    s = _ru_addc(s, _ru_addc(_ru_mulc(2, _ru_mulc(C, F)), _ru_addc(F, C)));
    if (_cfg_bias(cfg) == 1) { s = _ru_addc(s, _ru_addc(_ru_mulc(2, C), _ru_mulc(2, Ckv))); }
    return s;
}

# Checked packed parameter count: emb_end + NL*blk + 2C, or -1.
fn _ru_params_c(cfg): i64 {
    var C = _cfg_C(cfg);
    var s = _ru_addc(_ru_mulc(_cfg_V(cfg), C), _ru_mulc(_cfg_T(cfg), C));
    s = _ru_addc(s, _ru_mulc(_cfg_NL(cfg), _ru_blk_c(cfg)));
    return _ru_addc(s, _ru_mulc(2, C));
}

# ---- pre-norm block forward -------------------------------------------------
# xmid = xin + Attn(LN1(xin)); xout = xmid + MLP(LN2(xmid)). Safe in place
# (xin == xout): each op consumes its input into a scratch buffer before the
# residual add writes xout. pblk = params + _ru_blk_base(cfg, L)*8. Scratch: a /
# attn_out / b / mlp_out (T*C each), fc / gg (T*F each), m1/r1/m2/r2 (T each),
# arena (ru_attn_arena_size). Bit-identical to attn11's _attn_block_fwd + the MLP
# leg of model_forward (dropout off). A building block: cfg and the buffers are
# trusted (run ru_cfg_check first); the residual adds are _ru_add_rows.
fn ru_block_fwd(cfg, pblk, xin, xout, a, attn_out, b, mlp_out, fc, gg, m1, r1, m2, r2, arena): i64 {
    var C = _cfg_C(cfg);
    var T = _cfg_T(cfg);
    var nh = _cfg_nh(cfg);
    var nkv = _cfg_nkv(cfg);
    var F = _cfg_F(cfg);
    var TC = T * C;
    # x' = xin + Attn(LN1(xin))
    ru_ln_fwd(xin, pblk + _ru_o_ln1g(cfg) * 8, pblk + _ru_o_ln1b(cfg) * 8, a, m1, r1, T, C);
    ru_attn_fwd(pblk + _ru_o_Wq(cfg) * 8, _bq(cfg, pblk), pblk + _ru_o_Wk(cfg) * 8, _bk(cfg, pblk),
      pblk + _ru_o_Wv(cfg) * 8, _bv(cfg, pblk), pblk + _ru_o_Wo(cfg) * 8, _bo(cfg, pblk),
      a, attn_out, arena, T, C, nh, nkv, 0);
    _ru_add_rows(xout, xin, attn_out, TC);
    # x'' = x' + MLP(LN2(x'))
    ru_ln_fwd(xout, pblk + _ru_o_ln2g(cfg) * 8, pblk + _ru_o_ln2b(cfg) * 8, b, m2, r2, T, C);
    ru_mlp_fwd(b, pblk + _ru_o_Wfc(cfg) * 8, pblk + _ru_o_bfc(cfg) * 8, pblk + _ru_o_Wproj(cfg) * 8,
      pblk + _ru_o_bproj(cfg) * 8, fc, gg, mlp_out, T, C, F);
    _ru_add_rows(xout, xout, mlp_out, TC);
    return 0;
}

# ---- block-stack model forward ----------------------------------------------
# Forward scratch: x a attn_out b mlp_out af (T*C each) | fc gg (T*F each) |
# m1 r1 m2 r2 meanf rstdf (T each) | the attention arena. Every slot is written before
# it is read, so the block may be reused across calls without clearing (pinned by the
# dirty-scratch cases in tests/tcyr/guard.tcyr and the fuzz harness).
fn _ru_model_scratch_c(cfg): i64 {
    var T = _cfg_T(cfg);
    var s = _ru_mulc(6, _ru_mulc(T, _cfg_C(cfg)));
    s = _ru_addc(s, _ru_mulc(2, _ru_mulc(T, _cfg_F(cfg))));
    s = _ru_addc(s, _ru_mulc(6, T));
    return _ru_addc(s, _ru_arena_c(T, _cfg_C(cfg), _cfg_nh(cfg), _cfg_nkv(cfg)));
}

# f64 count of the caller-owned scratch ru_model_fwd_s needs, or RU_ERR_CFG (-1).
fn ru_model_scratch_count(cfg): i64 {
    if (ru_cfg_check(cfg) != 0) { return RU_ERR_CFG(); }
    return _ru_model_scratch_c(cfg);
}

# The checks every model-forward entry runs before writing: the config, the buffers it
# writes or reads (probs may be 0), and each of the T token ids against [0, V).
fn _ru_model_args(cfg, params, tokens, logits): i64 {
    var rc = ru_cfg_check(cfg);
    if (rc != 0) { return rc; }
    if (params == 0 || tokens == 0 || logits == 0) { return RU_ERR_ARG(); }
    var V = _cfg_V(cfg);
    var T = _cfg_T(cfg);
    var t = 0;
    while (t < T) {
        var tok = load64(tokens + t * 8);
        if (tok < 0 || tok >= V) { return RU_ERR_TOKEN(); }
        t = t + 1;
    }
    return RU_OK();
}

# tokens(T integer ids) -> logits(T,V) and, if probs != 0, probs(T,V), using the
# caller-owned `scratch` (ru_model_scratch_count(cfg) f64) — no allocation, so a caller
# that runs the forward in a loop reuses one block. Returns 0, or (before writing
# anything) RU_ERR_CFG / RU_ERR_ARG (a 0 params, tokens, logits or scratch) /
# RU_ERR_TOKEN (an id outside [0, V)). Bit-identical to ru_model_fwd.
# A prompt shorter than T: pad tokens to T with any valid id — attention is causal, so
# logits rows 0..n-1 do not depend on the padding.
fn ru_model_fwd_s(cfg, params, tokens, logits, probs, scratch): i64 {
    var rc = _ru_model_args(cfg, params, tokens, logits);
    if (rc != 0) { return rc; }
    if (scratch == 0) { return RU_ERR_ARG(); }
    return _ru_model_fwd_core(cfg, params, tokens, logits, probs, scratch);
}

# tokens(T integer ids) -> logits(T,V) and, if probs != 0, probs(T,V).
# embed -> NL pre-norm blocks (rolling residual, in place) -> final LN ->
# weight-tied head -> softmax. Mirrors attn11's model_forward with dropout off —
# bit-identical logits given identical packed params + tokens. Returns as
# ru_model_fwd_s does. ALLOCATES its scratch (one t_alloc of
# ru_model_scratch_count(cfg) f64 per call; through 0.5.1, fifteen) and the bump
# allocator never frees it: a caller that runs the forward repeatedly should use
# ru_model_fwd_s with one reused scratch block instead.
fn ru_model_fwd(cfg, params, tokens, logits, probs): i64 {
    var rc = _ru_model_args(cfg, params, tokens, logits);
    if (rc != 0) { return rc; }
    return _ru_model_fwd_core(cfg, params, tokens, logits, probs, t_alloc(_ru_model_scratch_c(cfg)));
}

# The forward body over a validated cfg / tokens and a scratch block (layout above).
fn _ru_model_fwd_core(cfg, params, tokens, logits, probs, scratch): i64 {
    var V = _cfg_V(cfg);
    var C = _cfg_C(cfg);
    var T = _cfg_T(cfg);
    var nh = _cfg_nh(cfg);
    var nkv = _cfg_nkv(cfg);
    var NL = _cfg_NL(cfg);
    var TC = T * C;
    var TF = T * _cfg_F(cfg);
    var x = scratch;
    var a = x + TC * 8;
    var attn_out = a + TC * 8;
    var b = attn_out + TC * 8;
    var mlp_out = b + TC * 8;
    var af = mlp_out + TC * 8;
    var fc = af + TC * 8;
    var gg = fc + TF * 8;
    var m1 = gg + TF * 8;
    var r1 = m1 + T * 8;
    var m2 = r1 + T * 8;
    var r2 = m2 + T * 8;
    var meanf = r2 + T * 8;
    var rstdf = meanf + T * 8;
    var arena = rstdf + T * 8;
    ru_embed_fwd(tokens, _p_tokemb(params), _p_posemb(params, cfg), x, T, C);
    var L = 0;
    while (L < NL) {
        var pblk = params + _ru_blk_base(cfg, L) * 8;
        ru_block_fwd(cfg, pblk, x, x, a, attn_out, b, mlp_out, fc, gg, m1, r1, m2, r2, arena);
        L = L + 1;
    }
    ru_ln_fwd(x, _p_lnfg(params, cfg), _p_lnfb(params, cfg), af, meanf, rstdf, T, C);
    ru_head_fwd(af, _p_tokemb(params), logits, T, C, V);
    if (probs != 0) { ru_softmax_fwd(logits, probs, T, V); }
    return 0;
}

# --- decode.cyr ---

# @public — rupantara KV-cache decode (M2): the incremental single-row forward.
# Process ONE token at window position `pos` against per-layer K/V caches, append
# this position's K/V, and produce its logits. Ported bit-identical from attn11
# `src/attn.cyr:attn_core_fwd_row / attn_fwd_row` + `src/model.cyr:model_fwd_row`
# (learned-absolute positions; causal MHA/GQA — rupantara's M1 scope: no RoPE /
# MLA / SSM / MoE). Reuses ru_ln_fwd / ru_mlp_fwd / ru_head_fwd_row on one row.
#
# ARITHMETIC CONTRACT (attn11 docs/architecture/003; Pope et al. 2022,
# arXiv:2211.05102 — KV-cache inference): each op here is the same kernel the
# batch path runs, on one row, in the same accumulation order (rosnet linear_fwd
# rows are independent, and causal attention makes position `pos` depend only on
# positions 0..pos), so a token's logits are BIT-IDENTICAL to row `pos` of the
# uncached ru_model_fwd over the same window. Pinned by tests/tcyr/decode.tcyr.

# ---- shared single-row attention core --------------------------------------
# q_row(C) at window position `pos`, K/V caches Kc/Vc ((>=pos+1, Ckv) holding
# positions 0..pos) -> concat_row(C): per-head causal softmax/PV for ONE query
# attending cache rows 0..pos. Each head is _ru_attn_qrow (src/attn.cyr) — the same
# routine the batch ru_attn_core_fwd runs for row `pos`, so the two cannot drift.
# prow: caller scratch (>= pos+1 f64), reused head by head. A leaf kernel: dims trusted.
fn ru_attn_core_fwd_row(q_row, Kc, Vc, prow, concat_row, pos, C, nh, nkv): i64 {
    var hd = C / nh;
    var Ckv = nkv * hd;
    var gsz = nh / nkv;
    var scale = f64_div(f64_from(1), f64_sqrt(f64_from(hd)));
    var h = 0;
    while (h < nh) {
        var base = h * hd;          # this query head's block in q_row/concat_row
        var kvb = (h / gsz) * hd;   # its shared K/V head's block in Kc/Vc
        _ru_attn_qrow(q_row + base * 8, Kc, Vc, prow, concat_row + base * 8, pos, Ckv, kvb, hd, scale);
        h = h + 1;
    }
    return 0;
}

# ---- cached single-row attention: project x_row, append K/V at pos, core, out proj
# x_row(1,C) -> out_row(1,C), appending this position's K/V to Kc/Vc ((T,Ckv),
# must already hold 0..pos-1). Uses rosnet linear_fwd (M=1); learned-pos only.
# A building block: pos < T and the buffers are the caller's (ru_model_fwd_row checks).
fn ru_attn_fwd_row(Wq, bq, Wk, bk, Wv, bv, Wo, bo, x_row, out_row,
  Kc, Vc, prow, concat_row, q_row, pos, C, nh, nkv): i64 {
    var Ckv = nkv * (C / nh);
    linear_fwd(x_row, Wq, bq, q_row, 1, C, C);
    linear_fwd(x_row, Wk, bk, Kc + pos * Ckv * 8, 1, C, Ckv);
    linear_fwd(x_row, Wv, bv, Vc + pos * Ckv * 8, 1, C, Ckv);
    ru_attn_core_fwd_row(q_row, Kc, Vc, prow, concat_row, pos, C, nh, nkv);
    linear_fwd(concat_row, Wo, bo, out_row, 1, C, C);
    return 0;
}

# ---- KV cache layout: [ K: NL*(T*Ckv) ][ V: NL*(T*Ckv) ], caller-owned --------
# t_alloc(ru_decode_kv_count(cfg)) once, reuse across a decode sequence. Returns
# RU_ERR_CFG (-1) for a config ru_cfg_check rejects.
fn ru_decode_kv_count(cfg): i64 {
    if (ru_cfg_check(cfg) != 0) { return RU_ERR_CFG(); }
    return _ru_decode_kv_c(cfg);
}
fn _ru_decode_kv_c(cfg): i64 { return _ru_mulc(2, _ru_mulc(_cfg_NL(cfg), _ru_mulc(_cfg_T(cfg), _cfg_Ckv(cfg)))); }
fn _ru_kv_k(kv, cfg, L): i64 { return kv + (L * _cfg_T(cfg) * _cfg_Ckv(cfg)) * 8; }
fn _ru_kv_v(kv, cfg, L): i64 { return kv + ((_cfg_NL(cfg) + L) * _cfg_T(cfg) * _cfg_Ckv(cfg)) * 8; }

# ---- decode-step scratch: rx ra rattn rconcat rq rb rmlp af (C each) | rfc rgg
# (F each) | rprow (T) | rm rr rm2 rr2 meanf rstdf (1 each). Every slot is written
# before it is read, so one block serves a whole decode sequence without clearing.
fn _ru_decode_scratch_c(cfg): i64 {
    var s = _ru_mulc(8, _cfg_C(cfg));
    s = _ru_addc(s, _ru_mulc(2, _cfg_F(cfg)));
    s = _ru_addc(s, _cfg_T(cfg));
    return _ru_addc(s, 6);
}

# f64 count of the caller-owned scratch ru_model_fwd_row_s needs, or RU_ERR_CFG (-1).
fn ru_decode_scratch_count(cfg): i64 {
    if (ru_cfg_check(cfg) != 0) { return RU_ERR_CFG(); }
    return _ru_decode_scratch_c(cfg);
}

# The checks every decode-step entry runs before writing anything — before the K/V
# append in particular: through 0.5.1 a `pos` at or past T (decoding past the context
# window — "generate 100 tokens" with T = 64) wrote this token's K and V rows past the
# end of the caller's KV cache, and read past the learned position table; a `tok`
# outside [0, V) read past the token embedding.
fn _ru_decode_args(cfg, params, tok, pos, kv, logits): i64 {
    var rc = ru_cfg_check(cfg);
    if (rc != 0) { return rc; }
    if (params == 0 || kv == 0 || logits == 0) { return RU_ERR_ARG(); }
    if (tok < 0 || tok >= _cfg_V(cfg)) { return RU_ERR_TOKEN(); }
    if (pos < 0 || pos >= _cfg_T(cfg)) { return RU_ERR_POS(); }
    return RU_OK();
}

# ---- cached single-token model forward (one decode step) --------------------
# `tok` at window position `pos`; `kv` (ru_decode_kv_count(cfg) f64) holds per-layer
# K/V for positions 0..pos-1. Appends this token's K/V and writes its logits(V),
# using the caller-owned `scratch` (ru_decode_scratch_count(cfg) f64) — no allocation
# per token. Bit-identical to row `pos` of the uncached ru_model_fwd over the same
# tokens. Returns 0, or (before writing anything, KV cache included) RU_ERR_CFG /
# RU_ERR_ARG (a 0 params, kv, logits or scratch) / RU_ERR_TOKEN / RU_ERR_POS.
fn ru_model_fwd_row_s(cfg, params, tok, pos, kv, logits, scratch): i64 {
    var rc = _ru_decode_args(cfg, params, tok, pos, kv, logits);
    if (rc != 0) { return rc; }
    if (scratch == 0) { return RU_ERR_ARG(); }
    return _ru_model_fwd_row_core(cfg, params, tok, pos, kv, logits, scratch);
}

# One decode step, as ru_model_fwd_row_s, but ALLOCATING its row scratch (one t_alloc
# of ru_decode_scratch_count(cfg) f64 per call; through 0.5.1, seventeen), which the
# bump allocator never frees — a generation loop grows the heap every token. A caller
# that decodes more than a few tokens should allocate one scratch block and call
# ru_model_fwd_row_s instead.
fn ru_model_fwd_row(cfg, params, tok, pos, kv, logits): i64 {
    var rc = _ru_decode_args(cfg, params, tok, pos, kv, logits);
    if (rc != 0) { return rc; }
    return _ru_model_fwd_row_core(cfg, params, tok, pos, kv, logits, t_alloc(_ru_decode_scratch_c(cfg)));
}

# The decode step over validated arguments and a scratch block (layout above).
fn _ru_model_fwd_row_core(cfg, params, tok, pos, kv, logits, scratch): i64 {
    var V = _cfg_V(cfg);
    var C = _cfg_C(cfg);
    var nh = _cfg_nh(cfg);
    var nkv = _cfg_nkv(cfg);
    var NL = _cfg_NL(cfg);
    var F = _cfg_F(cfg);
    var rx = scratch;
    var ra = rx + C * 8;
    var rattn = ra + C * 8;
    var rconcat = rattn + C * 8;
    var rq = rconcat + C * 8;
    var rb = rq + C * 8;
    var rmlp = rb + C * 8;
    var af = rmlp + C * 8;
    var rfc = af + C * 8;
    var rgg = rfc + F * 8;
    var rprow = rgg + F * 8;
    var rm = rprow + _cfg_T(cfg) * 8;
    var rr = rm + 8;
    var rm2 = rr + 8;
    var rr2 = rm2 + 8;
    var meanf = rr2 + 8;
    var rstdf = meanf + 8;
    # embed this token at position `pos` (token + learned-absolute position)
    _ru_add_rows(rx, _p_tokemb(params) + tok * C * 8, _p_posemb(params, cfg) + pos * C * 8, C);
    var L = 0;
    while (L < NL) {
        var pblk = params + _ru_blk_base(cfg, L) * 8;
        # x' = rx + Attn(LN1(rx))
        ru_ln_fwd(rx, pblk + _ru_o_ln1g(cfg) * 8, pblk + _ru_o_ln1b(cfg) * 8, ra, rm, rr, 1, C);
        ru_attn_fwd_row(pblk + _ru_o_Wq(cfg) * 8, _bq(cfg, pblk), pblk + _ru_o_Wk(cfg) * 8, _bk(cfg, pblk),
          pblk + _ru_o_Wv(cfg) * 8, _bv(cfg, pblk), pblk + _ru_o_Wo(cfg) * 8, _bo(cfg, pblk),
          ra, rattn, _ru_kv_k(kv, cfg, L), _ru_kv_v(kv, cfg, L), rprow, rconcat, rq, pos, C, nh, nkv);
        _ru_add_rows(rx, rx, rattn, C);
        # x'' = rx + MLP(LN2(rx))
        ru_ln_fwd(rx, pblk + _ru_o_ln2g(cfg) * 8, pblk + _ru_o_ln2b(cfg) * 8, rb, rm2, rr2, 1, C);
        ru_mlp_fwd(rb, pblk + _ru_o_Wfc(cfg) * 8, pblk + _ru_o_bfc(cfg) * 8, pblk + _ru_o_Wproj(cfg) * 8,
          pblk + _ru_o_bproj(cfg) * 8, rfc, rgg, rmlp, 1, C, F);
        _ru_add_rows(rx, rx, rmlp, C);
        L = L + 1;
    }
    ru_ln_fwd(rx, _p_lnfg(params, cfg), _p_lnfb(params, cfg), af, meanf, rstdf, 1, C);
    ru_head_fwd_row(af, _p_tokemb(params), logits, C, V);
    return 0;
}

# ---- greedy next-token: argmax over a logits(V) row -------------------------
# The index of the largest logit; on a tie the lowest index (strictly-greater scan).
# A NaN logit never wins (f64_gt is 0 against it) unless it is logits[0], which then
# stays the answer — a NaN-poisoned row returns 0, not a random id. RU_ERR_ARG (-4)
# for V < 1 (through 0.5.1 it read logits[0] of an empty row and returned 0).
fn ru_argmax(logits, V): i64 {
    if (V < 1) { return RU_ERR_ARG(); }
    var best = 0;
    var bv = load64(logits);
    var i = 1;
    while (i < V) {
        var lv = load64(logits + i * 8);
        if (f64_gt(lv, bv) == 1) { bv = lv; best = i; }
        i = i + 1;
    }
    return best;
}
