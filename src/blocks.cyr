# @public — rupantara transformer-forward composition: the pre-norm block and the
# block-stack forward, assembled from the leaf/core ops (norm/act/attn/mlp/embed/
# head). Ported from attn11 `src/model.cyr` (embed_fwd_n / _attn_block_fwd /
# model_forward), but WITHOUT attn11's model singleton — the model lives in a
# caller-owned packed parameter buffer + a small i64 config descriptor, so a
# consumer runs a transformer with no attn11 global state.
#
# Architecture: a pre-norm decoder-only Transformer (Vaswani et al. 2017,
# arXiv:1706.03762; pre-norm placement per Xiong et al. 2020, arXiv:2002.04745;
# GPT-2, Radford et al. 2019). M1 scope: MHA/GQA, learned-absolute positions,
# dense GELU MLP, LayerNorm, weight-tied LM head. No dropout — this is the
# inference forward (attn11's dropout is the identity in eval, so bit-identical).
#
# PACKED PARAMETER LAYOUT (element offsets) — byte-identical to attn11's MHA/dense
# layout, so attn11's g_params can feed ru_model_fwd directly (the parity contract):
#   [ tok_emb (V*C) ][ pos_emb (T*C) ][ block_0 ]...[ block_{NL-1} ][ lnf_g (C) ][ lnf_b (C) ]
# Each block (no attn bias):
#   ln1_g(C) ln1_b(C) Wq(C*C) Wk(C*Ckv) Wv(C*Ckv) Wo(C*C)
#   ln2_g(C) ln2_b(C) Wfc(C*F) bfc(F) Wproj(F*C) bproj(C)
# With attn bias, bq(C) bk(Ckv) bv(Ckv) bo(C) are appended after the base block
# (Ckv = nkv*(C/nh)); the base weight offsets are unchanged.

# Packed version int: major*10000 + minor*100 + patch (0.6.0 -> 600).
# NOTE: this constant sat at 400 through the whole of 0.4.1 — the 0.4.1 cut moved VERSION
# and the CHANGELOG but not this function, and tests/tcyr/smoke.tcyr asserted the stale
# value with a message naming 0.4.0, so the gate confirmed the bug instead of catching it.
# It drifted again through 0.4.3 (still 402). CI's docs job now checks it against VERSION.
# Bump BOTH on every cut.
fn rupantara_version(): i64 {
    return 600;
}

# ---- config descriptor (8 i64) ---------------------------------------------
# A caller-owned i64[8]: V, C, T, nh, nkv, NL, F, attn_bias. F is explicit (GPT-2
# uses 4*C) so a consumer with a different MLP ratio is not forced to 4*C. Stores the
# fields as given; ru_cfg_check validates them (every model entry runs it).
fn ru_cfg_init(cfg, V, C, T, nh, nkv, NL, F, attn_bias): i64 {
    store64(cfg, V);
    store64(cfg + 8, C);
    store64(cfg + 16, T);
    store64(cfg + 24, nh);
    store64(cfg + 32, nkv);
    store64(cfg + 40, NL);
    store64(cfg + 48, F);
    store64(cfg + 56, attn_bias);
    return 0;
}
fn _cfg_V(cfg): i64 { return load64(cfg); }
fn _cfg_C(cfg): i64 { return load64(cfg + 8); }
fn _cfg_T(cfg): i64 { return load64(cfg + 16); }
fn _cfg_nh(cfg): i64 { return load64(cfg + 24); }
fn _cfg_nkv(cfg): i64 { return load64(cfg + 32); }
fn _cfg_NL(cfg): i64 { return load64(cfg + 40); }
fn _cfg_F(cfg): i64 { return load64(cfg + 48); }
fn _cfg_bias(cfg): i64 { return load64(cfg + 56); }
fn _cfg_Ckv(cfg): i64 { return _cfg_nkv(cfg) * (_cfg_C(cfg) / _cfg_nh(cfg)); }

# 0 (RU_OK) when cfg describes a model every rupantara buffer and index can represent,
# else RU_ERR_CFG (-1). Checks: cfg != 0; V, C, T, nh, nkv, F >= 1 and NL >= 0;
# C % nh == 0 (whole heads); nh % nkv == 0 (whole GQA groups — nkv <= nh follows);
# attn_bias is 0 or 1; and every buffer the config sizes — the packed params, the
# forward scratch, the KV cache, the decode scratch and the (T, V) logits — stays
# within _RU_MAX_ELEMS(), so no element count or byte offset wraps. Through 0.5.1
# nothing checked: nh = 0 or nkv > nh divided by zero, C % nh != 0 left concat columns
# unwritten, nh % nkv != 0 sent heads past the last K/V head (reads off the end of the
# K/V rows), and attn_bias = 2 sized the block without biases but read them anyway.
fn ru_cfg_check(cfg): i64 {
    if (cfg == 0) { return RU_ERR_CFG(); }
    if (_cfg_V(cfg) < 1 || _cfg_F(cfg) < 1 || _cfg_NL(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_attn_dims_ok(_cfg_T(cfg), _cfg_C(cfg), _cfg_nh(cfg), _cfg_nkv(cfg)) == 0) { return RU_ERR_CFG(); }
    if (_cfg_bias(cfg) != 0 && _cfg_bias(cfg) != 1) { return RU_ERR_CFG(); }
    if (_ru_params_c(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_model_scratch_c(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_decode_kv_c(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_decode_scratch_c(cfg) < 0) { return RU_ERR_CFG(); }
    if (_ru_mulc(_cfg_T(cfg), _cfg_V(cfg)) < 0) { return RU_ERR_CFG(); }
    return RU_OK();
}

# ---- within-block element offsets (mirror attn11's _o_*) --------------------
fn _ru_o_ln1g(cfg): i64 { return 0; }
fn _ru_o_ln1b(cfg): i64 { return _cfg_C(cfg); }
fn _ru_o_Wq(cfg): i64 { return 2 * _cfg_C(cfg); }
fn _ru_o_Wk(cfg): i64 { var C = _cfg_C(cfg); return 2 * C + C * C; }
fn _ru_o_Wv(cfg): i64 { var C = _cfg_C(cfg); return 2 * C + C * C + C * _cfg_Ckv(cfg); }
fn _ru_o_Wo(cfg): i64 { var C = _cfg_C(cfg); return 2 * C + C * C + 2 * C * _cfg_Ckv(cfg); }
fn _ru_o_ln2g(cfg): i64 { return _ru_o_Wo(cfg) + _cfg_C(cfg) * _cfg_C(cfg); }
fn _ru_o_ln2b(cfg): i64 { return _ru_o_ln2g(cfg) + _cfg_C(cfg); }
fn _ru_o_Wfc(cfg): i64 { return _ru_o_ln2g(cfg) + 2 * _cfg_C(cfg); }
fn _ru_o_bfc(cfg): i64 { return _ru_o_Wfc(cfg) + _cfg_C(cfg) * _cfg_F(cfg); }
fn _ru_o_Wproj(cfg): i64 { return _ru_o_bfc(cfg) + _cfg_F(cfg); }
fn _ru_o_bproj(cfg): i64 { return _ru_o_Wproj(cfg) + _cfg_F(cfg) * _cfg_C(cfg); }

# base block size (no attn bias): 4C + 2C^2 + 2C*Ckv + (2C*F + F + C)
fn _ru_blk_base_size(cfg): i64 {
    var C = _cfg_C(cfg);
    var F = _cfg_F(cfg);
    return 4 * C + 2 * C * C + 2 * C * _cfg_Ckv(cfg) + (2 * C * F + F + C);
}
# attn-bias offsets (present only when enabled), appended after the base block
fn _ru_o_bq(cfg): i64 { return _ru_blk_base_size(cfg); }
fn _ru_o_bk(cfg): i64 { return _ru_blk_base_size(cfg) + _cfg_C(cfg); }
fn _ru_o_bv(cfg): i64 { return _ru_blk_base_size(cfg) + _cfg_C(cfg) + _cfg_Ckv(cfg); }
fn _ru_o_bo(cfg): i64 { return _ru_blk_base_size(cfg) + _cfg_C(cfg) + 2 * _cfg_Ckv(cfg); }
fn _ru_blk(cfg): i64 {
    if (_cfg_bias(cfg) == 1) { return _ru_blk_base_size(cfg) + 2 * _cfg_C(cfg) + 2 * _cfg_Ckv(cfg); }
    return _ru_blk_base_size(cfg);
}
fn _ru_emb_end(cfg): i64 { return _cfg_V(cfg) * _cfg_C(cfg) + _cfg_T(cfg) * _cfg_C(cfg); }
fn _ru_blk_base(cfg, L): i64 { return _ru_emb_end(cfg) + L * _ru_blk(cfg); }

# shared parameter sub-pointers (params is a byte pointer to the packed buffer)
fn _p_tokemb(params): i64 { return params; }
fn _p_posemb(params, cfg): i64 { return params + (_cfg_V(cfg) * _cfg_C(cfg)) * 8; }
fn _p_lnfg(params, cfg): i64 { return params + (_ru_emb_end(cfg) + _cfg_NL(cfg) * _ru_blk(cfg)) * 8; }
fn _p_lnfb(params, cfg): i64 { return _p_lnfg(params, cfg) + _cfg_C(cfg) * 8; }

# attn-bias sub-pointers — 0 (no bias) when disabled, mirroring attn11's P_bq etc.
fn _bq(cfg, pblk): i64 { if (_cfg_bias(cfg) == 0) { return 0; } return pblk + _ru_o_bq(cfg) * 8; }
fn _bk(cfg, pblk): i64 { if (_cfg_bias(cfg) == 0) { return 0; } return pblk + _ru_o_bk(cfg) * 8; }
fn _bv(cfg, pblk): i64 { if (_cfg_bias(cfg) == 0) { return 0; } return pblk + _ru_o_bv(cfg) * 8; }
fn _bo(cfg, pblk): i64 { if (_cfg_bias(cfg) == 0) { return 0; } return pblk + _ru_o_bo(cfg) * 8; }

# Total packed parameter count (elements) — sizes a params buffer for a config. The
# same count as ever for a valid config; RU_ERR_CFG (-1) when ru_cfg_check rejects it
# (through 0.5.1 a huge config could wrap this to a small positive count).
fn ru_params_count(cfg): i64 {
    if (ru_cfg_check(cfg) != 0) { return RU_ERR_CFG(); }
    return _ru_params_c(cfg);
}

# Checked block size: _ru_blk's formula with overflow-checked arithmetic, or -1.
fn _ru_blk_c(cfg): i64 {
    var C = _cfg_C(cfg);
    var F = _cfg_F(cfg);
    var Ckv = _cfg_Ckv(cfg);
    var s = _ru_mulc(4, C);
    s = _ru_addc(s, _ru_mulc(2, _ru_mulc(C, C)));
    s = _ru_addc(s, _ru_mulc(2, _ru_mulc(C, Ckv)));
    s = _ru_addc(s, _ru_addc(_ru_mulc(2, _ru_mulc(C, F)), _ru_addc(F, C)));
    if (_cfg_bias(cfg) == 1) { s = _ru_addc(s, _ru_addc(_ru_mulc(2, C), _ru_mulc(2, Ckv))); }
    return s;
}

# Checked packed parameter count: emb_end + NL*blk + 2C, or -1.
fn _ru_params_c(cfg): i64 {
    var C = _cfg_C(cfg);
    var s = _ru_addc(_ru_mulc(_cfg_V(cfg), C), _ru_mulc(_cfg_T(cfg), C));
    s = _ru_addc(s, _ru_mulc(_cfg_NL(cfg), _ru_blk_c(cfg)));
    return _ru_addc(s, _ru_mulc(2, C));
}

# ---- pre-norm block forward -------------------------------------------------
# xmid = xin + Attn(LN1(xin)); xout = xmid + MLP(LN2(xmid)). Safe in place
# (xin == xout): each op consumes its input into a scratch buffer before the
# residual add writes xout. pblk = params + _ru_blk_base(cfg, L)*8. Scratch: a /
# attn_out / b / mlp_out (T*C each), fc / gg (T*F each), m1/r1/m2/r2 (T each),
# arena (ru_attn_arena_size). Bit-identical to attn11's _attn_block_fwd + the MLP
# leg of model_forward (dropout off). A building block: cfg and the buffers are
# trusted (run ru_cfg_check first); the residual adds are _ru_add_rows. `arena` is the
# full ru_attn_arena_size(T, C, nh, nkv) one: its Pc holds the block's probabilities
# afterwards, as attn11's does.
fn ru_block_fwd(cfg, pblk, xin, xout, a, attn_out, b, mlp_out, fc, gg, m1, r1, m2, r2, arena): i64 {
    return _ru_block_rows(cfg, pblk, xin, xout, a, attn_out, b, mlp_out, fc, gg, m1, r1, m2, r2,
      arena, _cfg_T(cfg), 0);
}

# The block over the first n rows (1 <= n <= T; every buffer holds n rows). lean = 0
# runs ru_attn_fwd over a full arena (ru_attn_arena_size(n, ...), Pc included); lean = 1
# runs _ru_attn_fwd_lean over a lean one (_ru_lean_arena_c(n, ...)). xout is
# bit-identical either way, and its rows 0..n-1 match the T-row block's: every op is
# row-wise except attention, which is causal.
fn _ru_block_rows(cfg, pblk, xin, xout, a, attn_out, b, mlp_out, fc, gg, m1, r1, m2, r2, arena, n, lean): i64 {
    var C = _cfg_C(cfg);
    var nh = _cfg_nh(cfg);
    var nkv = _cfg_nkv(cfg);
    var nC = n * C;
    # x' = xin + Attn(LN1(xin))
    ru_ln_fwd(xin, pblk + _ru_o_ln1g(cfg) * 8, pblk + _ru_o_ln1b(cfg) * 8, a, m1, r1, n, C);
    var Wq = pblk + _ru_o_Wq(cfg) * 8;
    var Wk = pblk + _ru_o_Wk(cfg) * 8;
    var Wv = pblk + _ru_o_Wv(cfg) * 8;
    var Wo = pblk + _ru_o_Wo(cfg) * 8;
    if (lean == 1) {
        _ru_attn_fwd_lean(Wq, _bq(cfg, pblk), Wk, _bk(cfg, pblk), Wv, _bv(cfg, pblk), Wo, _bo(cfg, pblk),
          a, attn_out, arena, n, C, nh, nkv);
    } else {
        ru_attn_fwd(Wq, _bq(cfg, pblk), Wk, _bk(cfg, pblk), Wv, _bv(cfg, pblk), Wo, _bo(cfg, pblk),
          a, attn_out, arena, n, C, nh, nkv, 0);
    }
    _ru_add_rows(xout, xin, attn_out, nC);
    # x'' = x' + MLP(LN2(x'))
    ru_ln_fwd(xout, pblk + _ru_o_ln2g(cfg) * 8, pblk + _ru_o_ln2b(cfg) * 8, b, m2, r2, n, C);
    ru_mlp_fwd(b, pblk + _ru_o_Wfc(cfg) * 8, pblk + _ru_o_bfc(cfg) * 8, pblk + _ru_o_Wproj(cfg) * 8,
      pblk + _ru_o_bproj(cfg) * 8, fc, gg, mlp_out, n, C, _cfg_F(cfg));
    _ru_add_rows(xout, xout, mlp_out, nC);
    return 0;
}

# ---- block-stack model forward ----------------------------------------------
# Forward scratch for n rows: x a attn_out b mlp_out af (n*C each) | fc gg (n*F each) |
# m1 r1 m2 r2 meanf rstdf (n each) | the lean attention arena (_ru_lean_arena_c, no
# nh*n*n probabilities since 0.6.0). Every slot is written before it is read, so the
# block may be reused across calls without clearing (pinned by the dirty-scratch cases
# in tests/tcyr/guard.tcyr and the fuzz harness). Or -1.
fn _ru_model_scratch_n(cfg, n): i64 {
    var s = _ru_mulc(6, _ru_mulc(n, _cfg_C(cfg)));
    s = _ru_addc(s, _ru_mulc(2, _ru_mulc(n, _cfg_F(cfg))));
    s = _ru_addc(s, _ru_mulc(6, n));
    return _ru_addc(s, _ru_lean_arena_c(n, _cfg_C(cfg), _cfg_nh(cfg), _cfg_nkv(cfg)));
}

# The whole window's scratch (n = T): what ru_model_scratch_count reports, enough for
# any run length.
fn _ru_model_scratch_c(cfg): i64 { return _ru_model_scratch_n(cfg, _cfg_T(cfg)); }

# f64 count of the caller-owned scratch ru_model_fwd_s needs, or RU_ERR_CFG (-1).
fn ru_model_scratch_count(cfg): i64 {
    if (ru_cfg_check(cfg) != 0) { return RU_ERR_CFG(); }
    return _ru_model_scratch_c(cfg);
}

# The checks every model-forward entry runs before writing: the config, the buffers it
# writes or reads (probs may be 0), the run length n (1 <= n <= T) and each of the n
# token ids against [0, V). Ids past n are not read.
fn _ru_model_args(cfg, params, tokens, n, logits): i64 {
    var rc = ru_cfg_check(cfg);
    if (rc != 0) { return rc; }
    if (params == 0 || tokens == 0 || logits == 0) { return RU_ERR_ARG(); }
    if (n < 1) { return RU_ERR_ARG(); }
    if (n > _cfg_T(cfg)) { return RU_ERR_POS(); }
    var V = _cfg_V(cfg);
    var t = 0;
    while (t < n) {
        var tok = load64(tokens + t * 8);
        if (tok < 0 || tok >= V) { return RU_ERR_TOKEN(); }
        t = t + 1;
    }
    return RU_OK();
}

# The variable-length forward on caller scratch (0.6.0): tokens(n integer ids), with
# 1 <= n <= T, at window positions 0..n-1 -> logits(n,V) and, if probs != 0, probs(n,V).
# T stays the layout's context (the pos_emb rows); n is the run length, so one packed
# parameter buffer serves every prompt length. Rows 0..n-1 are bit-identical to those of
# ru_model_fwd over the same tokens padded to T with any valid ids (attention is causal).
# `scratch` holds ru_model_scratch_count(cfg) f64 — sized for T, so one block serves any
# n — and needs no clearing. Returns 0, or (before writing anything) RU_ERR_CFG /
# RU_ERR_ARG (n < 1, or a 0 params, tokens, logits or scratch) / RU_ERR_POS (n > T) /
# RU_ERR_TOKEN (one of the n ids outside [0, V)).
fn ru_model_fwd_n_s(cfg, params, tokens, n, logits, probs, scratch): i64 {
    var rc = _ru_model_args(cfg, params, tokens, n, logits);
    if (rc != 0) { return rc; }
    if (scratch == 0) { return RU_ERR_ARG(); }
    return _ru_model_fwd_core(cfg, params, tokens, n, logits, probs, scratch);
}

# The variable-length forward, as ru_model_fwd_n_s, but ALLOCATING its scratch (one
# t_alloc sized for n rows per call), which the bump allocator never frees: a caller
# that runs the forward repeatedly should use ru_model_fwd_n_s with one reused block.
fn ru_model_fwd_n(cfg, params, tokens, n, logits, probs): i64 {
    var rc = _ru_model_args(cfg, params, tokens, n, logits);
    if (rc != 0) { return rc; }
    return _ru_model_fwd_core(cfg, params, tokens, n, logits, probs, t_alloc(_ru_model_scratch_n(cfg, n)));
}

# tokens(T integer ids) -> logits(T,V) and, if probs != 0, probs(T,V), using the
# caller-owned `scratch` (ru_model_scratch_count(cfg) f64) — no allocation, so a caller
# that runs the forward in a loop reuses one block. Returns 0, or (before writing
# anything) RU_ERR_CFG / RU_ERR_ARG (a 0 params, tokens, logits or scratch) /
# RU_ERR_TOKEN (an id outside [0, V)). Bit-identical to ru_model_fwd. The whole-window
# case of ru_model_fwd_n_s; for a prompt shorter than T, call that with n instead of
# padding.
fn ru_model_fwd_s(cfg, params, tokens, logits, probs, scratch): i64 {
    if (cfg == 0) { return RU_ERR_CFG(); }
    return ru_model_fwd_n_s(cfg, params, tokens, _cfg_T(cfg), logits, probs, scratch);
}

# tokens(T integer ids) -> logits(T,V) and, if probs != 0, probs(T,V).
# embed -> NL pre-norm blocks (rolling residual, in place) -> final LN ->
# weight-tied head -> softmax. Mirrors attn11's model_forward with dropout off —
# bit-identical logits given identical packed params + tokens. Returns as
# ru_model_fwd_s does. ALLOCATES its scratch (one t_alloc of
# ru_model_scratch_count(cfg) f64 per call; through 0.5.1, fifteen) and the bump
# allocator never frees it: a caller that runs the forward repeatedly should use
# ru_model_fwd_s with one reused scratch block instead.
fn ru_model_fwd(cfg, params, tokens, logits, probs): i64 {
    if (cfg == 0) { return RU_ERR_CFG(); }
    return ru_model_fwd_n(cfg, params, tokens, _cfg_T(cfg), logits, probs);
}

# The forward body over a validated cfg, n and tokens and a scratch block laid out for
# n rows (layout above; a block sized for T holds it).
fn _ru_model_fwd_core(cfg, params, tokens, n, logits, probs, scratch): i64 {
    var V = _cfg_V(cfg);
    var C = _cfg_C(cfg);
    var NL = _cfg_NL(cfg);
    var nC = n * C;
    var nF = n * _cfg_F(cfg);
    var x = scratch;
    var a = x + nC * 8;
    var attn_out = a + nC * 8;
    var b = attn_out + nC * 8;
    var mlp_out = b + nC * 8;
    var af = mlp_out + nC * 8;
    var fc = af + nC * 8;
    var gg = fc + nF * 8;
    var m1 = gg + nF * 8;
    var r1 = m1 + n * 8;
    var m2 = r1 + n * 8;
    var r2 = m2 + n * 8;
    var meanf = r2 + n * 8;
    var rstdf = meanf + n * 8;
    var arena = rstdf + n * 8;
    ru_embed_fwd(tokens, _p_tokemb(params), _p_posemb(params, cfg), x, n, C);
    var L = 0;
    while (L < NL) {
        var pblk = params + _ru_blk_base(cfg, L) * 8;
        _ru_block_rows(cfg, pblk, x, x, a, attn_out, b, mlp_out, fc, gg, m1, r1, m2, r2, arena, n, 1);
        L = L + 1;
    }
    ru_ln_fwd(x, _p_lnfg(params, cfg), _p_lnfb(params, cfg), af, meanf, rstdf, n, C);
    ru_head_fwd(af, _p_tokemb(params), logits, n, C, V);
    if (probs != 0) { ru_softmax_fwd(logits, probs, n, V); }
    return 0;
}
