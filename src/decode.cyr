# @public — rupantara KV-cache decode (M2): the incremental single-row forward.
# Process ONE token at window position `pos` against per-layer K/V caches, append
# this position's K/V, and produce its logits. Ported bit-identical from attn11
# `src/attn.cyr:attn_core_fwd_row / attn_fwd_row` + `src/model.cyr:model_fwd_row`
# (learned-absolute positions; causal MHA/GQA — rupantara's M1 scope: no RoPE /
# MLA / SSM / MoE). Reuses ru_ln_fwd / ru_mlp_fwd / ru_head_fwd_row on one row.
#
# ARITHMETIC CONTRACT (attn11 docs/architecture/003; Pope et al. 2022,
# arXiv:2211.05102 — KV-cache inference): each op here is the same kernel the
# batch path runs, on one row, in the same accumulation order (rosnet linear_fwd
# rows are independent, and causal attention makes position `pos` depend only on
# positions 0..pos), so a token's logits are BIT-IDENTICAL to row `pos` of the
# uncached ru_model_fwd over the same window. Pinned by tests/tcyr/decode.tcyr.

# ---- shared single-row attention core --------------------------------------
# q_row(C) at window position `pos`, K/V caches Kc/Vc ((>=pos+1, Ckv) holding
# positions 0..pos) -> concat_row(C): per-head causal softmax/PV for ONE query
# attending cache rows 0..pos. Each head is _ru_attn_qrow (src/attn.cyr) — the same
# routine the batch ru_attn_core_fwd runs for row `pos`, so the two cannot drift.
# prow: caller scratch (>= pos+1 f64), reused head by head. A leaf kernel: dims trusted.
fn ru_attn_core_fwd_row(q_row, Kc, Vc, prow, concat_row, pos, C, nh, nkv): i64 {
    var hd = C / nh;
    var Ckv = nkv * hd;
    var gsz = nh / nkv;
    var scale = f64_div(f64_from(1), f64_sqrt(f64_from(hd)));
    var h = 0;
    while (h < nh) {
        var base = h * hd;          # this query head's block in q_row/concat_row
        var kvb = (h / gsz) * hd;   # its shared K/V head's block in Kc/Vc
        _ru_attn_qrow(q_row + base * 8, Kc, Vc, prow, concat_row + base * 8, pos, Ckv, kvb, hd, scale);
        h = h + 1;
    }
    return 0;
}

# ---- cached single-row attention: project x_row, append K/V at pos, core, out proj
# x_row(1,C) -> out_row(1,C), appending this position's K/V to Kc/Vc ((T,Ckv),
# must already hold 0..pos-1). Uses rosnet linear_fwd (M=1); learned-pos only.
# A building block: pos < T and the buffers are the caller's (ru_model_fwd_row checks).
fn ru_attn_fwd_row(Wq, bq, Wk, bk, Wv, bv, Wo, bo, x_row, out_row,
  Kc, Vc, prow, concat_row, q_row, pos, C, nh, nkv): i64 {
    var Ckv = nkv * (C / nh);
    linear_fwd(x_row, Wq, bq, q_row, 1, C, C);
    linear_fwd(x_row, Wk, bk, Kc + pos * Ckv * 8, 1, C, Ckv);
    linear_fwd(x_row, Wv, bv, Vc + pos * Ckv * 8, 1, C, Ckv);
    ru_attn_core_fwd_row(q_row, Kc, Vc, prow, concat_row, pos, C, nh, nkv);
    linear_fwd(concat_row, Wo, bo, out_row, 1, C, C);
    return 0;
}

# ---- KV cache layout: [ K: NL*(T*Ckv) ][ V: NL*(T*Ckv) ], caller-owned --------
# t_alloc(ru_decode_kv_count(cfg)) once, reuse across a decode sequence. Returns
# RU_ERR_CFG (-1) for a config ru_cfg_check rejects.
fn ru_decode_kv_count(cfg): i64 {
    if (ru_cfg_check(cfg) != 0) { return RU_ERR_CFG(); }
    return _ru_decode_kv_c(cfg);
}
fn _ru_decode_kv_c(cfg): i64 { return _ru_mulc(2, _ru_mulc(_cfg_NL(cfg), _ru_mulc(_cfg_T(cfg), _cfg_Ckv(cfg)))); }
fn _ru_kv_k(kv, cfg, L): i64 { return kv + (L * _cfg_T(cfg) * _cfg_Ckv(cfg)) * 8; }
fn _ru_kv_v(kv, cfg, L): i64 { return kv + ((_cfg_NL(cfg) + L) * _cfg_T(cfg) * _cfg_Ckv(cfg)) * 8; }

# ---- decode-step scratch: rx ra rattn rconcat rq rb rmlp af (C each) | rfc rgg
# (F each) | rprow (T) | rm rr rm2 rr2 meanf rstdf (1 each). Every slot is written
# before it is read, so one block serves a whole decode sequence without clearing.
fn _ru_decode_scratch_c(cfg): i64 {
    var s = _ru_mulc(8, _cfg_C(cfg));
    s = _ru_addc(s, _ru_mulc(2, _cfg_F(cfg)));
    s = _ru_addc(s, _cfg_T(cfg));
    return _ru_addc(s, 6);
}

# f64 count of the caller-owned scratch ru_model_fwd_row_s needs, or RU_ERR_CFG (-1).
fn ru_decode_scratch_count(cfg): i64 {
    if (ru_cfg_check(cfg) != 0) { return RU_ERR_CFG(); }
    return _ru_decode_scratch_c(cfg);
}

# The checks every decode-step entry runs before writing anything — before the K/V
# append in particular: through 0.5.1 a `pos` at or past T (decoding past the context
# window — "generate 100 tokens" with T = 64) wrote this token's K and V rows past the
# end of the caller's KV cache, and read past the learned position table; a `tok`
# outside [0, V) read past the token embedding.
fn _ru_decode_args(cfg, params, tok, pos, kv, logits): i64 {
    var rc = ru_cfg_check(cfg);
    if (rc != 0) { return rc; }
    if (params == 0 || kv == 0 || logits == 0) { return RU_ERR_ARG(); }
    if (tok < 0 || tok >= _cfg_V(cfg)) { return RU_ERR_TOKEN(); }
    if (pos < 0 || pos >= _cfg_T(cfg)) { return RU_ERR_POS(); }
    return RU_OK();
}

# ---- cached single-token model forward (one decode step) --------------------
# `tok` at window position `pos`; `kv` (ru_decode_kv_count(cfg) f64) holds per-layer
# K/V for positions 0..pos-1. Appends this token's K/V and writes its logits(V),
# using the caller-owned `scratch` (ru_decode_scratch_count(cfg) f64) — no allocation
# per token. Bit-identical to row `pos` of the uncached ru_model_fwd over the same
# tokens. Returns 0, or (before writing anything, KV cache included) RU_ERR_CFG /
# RU_ERR_ARG (a 0 params, kv, logits or scratch) / RU_ERR_TOKEN / RU_ERR_POS.
fn ru_model_fwd_row_s(cfg, params, tok, pos, kv, logits, scratch): i64 {
    var rc = _ru_decode_args(cfg, params, tok, pos, kv, logits);
    if (rc != 0) { return rc; }
    if (scratch == 0) { return RU_ERR_ARG(); }
    return _ru_model_fwd_row_core(cfg, params, tok, pos, kv, logits, scratch);
}

# One decode step, as ru_model_fwd_row_s, but ALLOCATING its row scratch (one t_alloc
# of ru_decode_scratch_count(cfg) f64 per call; through 0.5.1, seventeen), which the
# bump allocator never frees — a generation loop grows the heap every token. A caller
# that decodes more than a few tokens should allocate one scratch block and call
# ru_model_fwd_row_s instead.
fn ru_model_fwd_row(cfg, params, tok, pos, kv, logits): i64 {
    var rc = _ru_decode_args(cfg, params, tok, pos, kv, logits);
    if (rc != 0) { return rc; }
    return _ru_model_fwd_row_core(cfg, params, tok, pos, kv, logits, t_alloc(_ru_decode_scratch_c(cfg)));
}

# The decode step over validated arguments and a scratch block (layout above).
fn _ru_model_fwd_row_core(cfg, params, tok, pos, kv, logits, scratch): i64 {
    var V = _cfg_V(cfg);
    var C = _cfg_C(cfg);
    var nh = _cfg_nh(cfg);
    var nkv = _cfg_nkv(cfg);
    var NL = _cfg_NL(cfg);
    var F = _cfg_F(cfg);
    var rx = scratch;
    var ra = rx + C * 8;
    var rattn = ra + C * 8;
    var rconcat = rattn + C * 8;
    var rq = rconcat + C * 8;
    var rb = rq + C * 8;
    var rmlp = rb + C * 8;
    var af = rmlp + C * 8;
    var rfc = af + C * 8;
    var rgg = rfc + F * 8;
    var rprow = rgg + F * 8;
    var rm = rprow + _cfg_T(cfg) * 8;
    var rr = rm + 8;
    var rm2 = rr + 8;
    var rr2 = rm2 + 8;
    var meanf = rr2 + 8;
    var rstdf = meanf + 8;
    # embed this token at position `pos` (token + learned-absolute position)
    _ru_add_rows(rx, _p_tokemb(params) + tok * C * 8, _p_posemb(params, cfg) + pos * C * 8, C);
    var L = 0;
    while (L < NL) {
        var pblk = params + _ru_blk_base(cfg, L) * 8;
        # x' = rx + Attn(LN1(rx))
        ru_ln_fwd(rx, pblk + _ru_o_ln1g(cfg) * 8, pblk + _ru_o_ln1b(cfg) * 8, ra, rm, rr, 1, C);
        ru_attn_fwd_row(pblk + _ru_o_Wq(cfg) * 8, _bq(cfg, pblk), pblk + _ru_o_Wk(cfg) * 8, _bk(cfg, pblk),
          pblk + _ru_o_Wv(cfg) * 8, _bv(cfg, pblk), pblk + _ru_o_Wo(cfg) * 8, _bo(cfg, pblk),
          ra, rattn, _ru_kv_k(kv, cfg, L), _ru_kv_v(kv, cfg, L), rprow, rconcat, rq, pos, C, nh, nkv);
        _ru_add_rows(rx, rx, rattn, C);
        # x'' = rx + MLP(LN2(rx))
        ru_ln_fwd(rx, pblk + _ru_o_ln2g(cfg) * 8, pblk + _ru_o_ln2b(cfg) * 8, rb, rm2, rr2, 1, C);
        ru_mlp_fwd(rb, pblk + _ru_o_Wfc(cfg) * 8, pblk + _ru_o_bfc(cfg) * 8, pblk + _ru_o_Wproj(cfg) * 8,
          pblk + _ru_o_bproj(cfg) * 8, rfc, rgg, rmlp, 1, C, F);
        _ru_add_rows(rx, rx, rmlp, C);
        L = L + 1;
    }
    ru_ln_fwd(rx, _p_lnfg(params, cfg), _p_lnfb(params, cfg), af, meanf, rstdf, 1, C);
    ru_head_fwd_row(af, _p_tokemb(params), logits, C, V);
    return 0;
}

# ---- greedy next-token: argmax over a logits(V) row -------------------------
# The index of the largest logit; on a tie the lowest index (strictly-greater scan).
# A NaN logit never wins (f64_gt is 0 against it) unless it is logits[0], which then
# stays the answer — a NaN-poisoned row returns 0, not a random id. RU_ERR_ARG (-4)
# for V < 1 (through 0.5.1 it read logits[0] of an empty row and returned 0).
fn ru_argmax(logits, V): i64 {
    if (V < 1) { return RU_ERR_ARG(); }
    var best = 0;
    var bv = load64(logits);
    var i = 1;
    while (i < V) {
        var lv = load64(logits + i * 8);
        if (f64_gt(lv, bv) == 1) { bv = lv; best = i; }
        i = i + 1;
    }
    return best;
}
