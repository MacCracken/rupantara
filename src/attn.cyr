# @public — causal multi-head self-attention FORWARD. Ported bit-identical from
# attn11 `src/attn.cyr` (ru_attn_core_fwd + ru_attn_fwd), with the training-only paths
# removed: no GPU fast-path, no bidirectional (diffusion) mask, no RoPE branch
# (M1 is learned-absolute positions; RoPE is a later increment). Names + the
# per-head arithmetic are kept IDENTICAL to attn11 so the eventual re-point is a
# clean drop-in (extract-and-re-fold).
#
# Source: Vaswani et al. (2017), "Attention Is All You Need", arXiv:1706.03762 —
# scaled dot-product attention: score = (Q·K)/sqrt(hd), softmax, multi-head split.
# Grouped-query attention (nkv < nh): Ainslie et al. (2023), arXiv:2305.13245;
# multi-query (nkv == 1): Shazeer (2019), arXiv:1911.02150.
#
# Single sequence of length T, embedding width C, nh query heads, head dim
# hd = C/nh, and nkv K/V heads (nkv divides nh; nkv == nh is classic MHA).
# Q/O projections are C x C; K/V projections are C x Ckv where Ckv = nkv*hd —
# each group of gsz = nh/nkv query heads shares one K/V head. Query heads occupy
# contiguous column blocks [h*hd, (h+1)*hd) of the (T,C) Q/concat tensors; K/V
# head g occupies [g*hd, (g+1)*hd) of the (T,Ckv) K/V.

# ---- forward-only attention arena -------------------------------------------
# The forward caches live in one pre-allocated arena (fixed shapes). Layout — the
# FIRST five regions of attn11's arena, in the SAME order, so the sub-pointer math
# below is byte-identical to attn11's (attn11's full arena, which also carries the
# backward temporaries, drops straight into ru_attn_fwd here). rupantara is
# forward-only, so it sizes just these five:
#   Qc       : T*C
#   Kc Vc    : T*Ckv each
#   Pc       : nh*T*T   (attention probabilities, causal-masked)
#   concat   : T*C      (pre-Wo head concatenation)
# Returns the element count, or RU_ERR_CFG() (-1) for a shape the kernels cannot index
# (a dim < 1, C % nh != 0, nh % nkv != 0) or one whose arena would pass
# _RU_MAX_ELEMS() — so t_alloc refuses it loudly instead of a wrapped size coming back
# small (it divided by zero at nh = 0 and wrapped silently through 0.5.1).
fn ru_attn_arena_size(T, C, nh, nkv): i64 {
    if (_ru_attn_dims_ok(T, C, nh, nkv) == 0) { return RU_ERR_CFG(); }
    return _ru_arena_c(T, C, nh, nkv);
}

# arena sub-pointers (deterministic given dims; Ckv = nkv * (C/nh)) — identical to
# attn11's _ru_at_Qc.._ru_at_concat (these regions come first, so the offsets match
# regardless of whether the backward temporaries follow).
fn _ru_at_Qc(ar): i64 { return ar; }
fn _ru_at_Kc(ar, T, C): i64 { return ar + (T * C) * 8; }
fn _ru_at_Vc(ar, T, C, Ckv): i64 { return ar + (T * C + T * Ckv) * 8; }
fn _ru_at_Pc(ar, T, C, Ckv): i64 { return ar + (T * C + 2 * T * Ckv) * 8; }
fn _ru_at_concat(ar, T, C, nh, Ckv): i64 { return ar + (T * C + 2 * T * Ckv + nh * T * T) * 8; }

# ---- one (query head, query position) pair: THE per-head arithmetic -----------
# The single source of truth for both attention cores (the batch ru_attn_core_fwd
# below and the cached-decode ru_attn_core_fwd_row in decode.cyr), so cached decode is
# bit-identical to the batch forward by construction, not by two copies kept in step
# (through 0.5.1 they were two ~45-line copies).
#   qbase : this query head's hd-block of its Q row
#   Kc/Vc : (>= jhi+1, Ckv) key / value rows; kvb = this head's shared K/V head offset
#   prow  : jhi+1 f64 out — the softmax probabilities over keys 0..jhi
#   cbase : hd f64 out — sum_j prow[j] * V[j, kvb..kvb+hd)
# Scores: a 4-lane f64v_fmadd dot over the head dim, the lanes tree-reduced, then the
# 0..3-element scalar tail; times scale = 1/sqrt(hd). Softmax: max-subtracted exp,
# one division, scaled. PV: one f64v_axpy per key over the 4-aligned body (0.5.2),
# then the same scalar tail. The axpy replaced a broadcast-buffer fill plus one
# f64v_fmadd per 4 elements: each element still gets round(round(p*v) + acc) in
# ascending-j order (mulpd + addpd on x86_64; FMLA on aarch64, where f64v_fmadd also
# fuses), and the vector/scalar split stays at hd4 — rosnet ADR 0002's rule, the same
# change rosnet 1.2.2 made to linear_fwd. Bit-identical to 0.5.1 (tests/tcyr/reference.tcyr).
fn _ru_attn_qrow(qbase, Kc, Vc, prow, cbase, jhi, Ckv, kvb, hd, scale): i64 {
    var hd4 = hd - (hd % 4);        # head dim is contiguous -> 4-wide vector body
    var acc[32];                    # 4-lane dot accumulator (fn-local: 32 bytes = 4 f64)
    # raw scores for keys j = 0..jhi
    var j = 0;
    while (j <= jhi) {
        var kbase = Kc + (j * Ckv + kvb) * 8;
        store64(&acc, f64_from(0)); store64(&acc + 8, f64_from(0));
        store64(&acc + 16, f64_from(0)); store64(&acc + 24, f64_from(0));
        var d = 0;
        while (d < hd4) {
            f64v_fmadd(&acc, qbase + d * 8, kbase + d * 8, &acc, 4);
            d = d + 4;
        }
        var dot = f64_add(f64_add(load64(&acc), load64(&acc + 8)),
          f64_add(load64(&acc + 16), load64(&acc + 24)));
        while (d < hd) {
            dot = f64_add(dot, f64_mul(load64(qbase + d * 8), load64(kbase + d * 8)));
            d = d + 1;
        }
        store64(prow + j * 8, f64_mul(dot, scale));
        j = j + 1;
    }
    # softmax over j = 0..jhi
    var mx = load64(prow);
    j = 1;
    while (j <= jhi) {
        var s = load64(prow + j * 8);
        if (f64_gt(s, mx) == 1) { mx = s; }
        j = j + 1;
    }
    var sum = f64_from(0);
    j = 0;
    while (j <= jhi) {
        var e = f64_exp(f64_sub(load64(prow + j * 8), mx));
        store64(prow + j * 8, e);
        sum = f64_add(sum, e);
        j = j + 1;
    }
    var inv = f64_div(f64_from(1), sum);
    j = 0;
    while (j <= jhi) { store64(prow + j * 8, f64_mul(load64(prow + j * 8), inv)); j = j + 1; }
    # cbase[d] = sum_j P[j] * V[j, kvb+d]: an axpy over the contiguous head dim per key
    var dz = 0;
    while (dz < hd) { store64(cbase + dz * 8, f64_from(0)); dz = dz + 1; }
    j = 0;
    while (j <= jhi) {
        var pij = load64(prow + j * 8);
        var vbase = Vc + (j * Ckv + kvb) * 8;
        f64v_axpy(cbase, vbase, pij, hd4);       # hd4 is a multiple of 4: no tail past cbase
        var d = hd4;
        while (d < hd) {
            store64(cbase + d * 8, f64_add(load64(cbase + d * 8),
                f64_mul(pij, load64(vbase + d * 8))));
            d = d + 1;
        }
        j = j + 1;
    }
    return 0;
}

# ---- shared attention core (post-projection) --------------------------------
# Given Qc(T,C), Kc(T,Ckv), Vc(T,Ckv) it fills Pc(nh,T,T) and concat(T,C): causal
# scaled-dot-product, each query head h attending its shared K/V head
# kvb = (h/gsz)*hd, query i attending keys 0..i. The per-pair arithmetic is
# _ru_attn_qrow above. A leaf kernel: dims are trusted (C % nh == 0 and nh % nkv == 0
# are the caller's — the model entries check them; see src/guard.cyr).
fn ru_attn_core_fwd(Qc, Kc, Vc, Pc, concat, T, C, nh, nkv): i64 {
    # zero the full probability buffer (upper triangle stays 0)
    t_zero(Pc, nh * T * T);
    return _ru_attn_core(Qc, Kc, Vc, Pc, 0, concat, T, C, nh, nkv);
}

# The batch core's loop: head h outer, query row i inner (one head's K/V slice stays
# cache-resident across the rows), each pair _ru_attn_qrow. Pc != 0: pair (h, i) writes
# its probabilities to Pc row (h*T + i) — ru_attn_core_fwd. Pc == 0: every pair reuses
# the one T-element `prow` — the model forward's lean attention (0.6.0), which never
# reads them again. concat is the same either way: the same routine on the same inputs.
fn _ru_attn_core(Qc, Kc, Vc, Pc, prow, concat, T, C, nh, nkv): i64 {
    var hd = C / nh;
    var Ckv = nkv * hd;
    var gsz = nh / nkv;             # query heads per K/V head (GQA group size)
    var scale = f64_div(f64_from(1), f64_sqrt(f64_from(hd)));
    var h = 0;
    while (h < nh) {
        var base = h * hd;          # this query head's block in Q/concat
        var kvb = (h / gsz) * hd;   # its shared K/V head's block in Kc/Vc
        var i = 0;
        while (i < T) {
            var pr = prow;
            if (Pc != 0) { pr = Pc + (h * T + i) * T * 8; }
            _ru_attn_qrow(Qc + (i * C + base) * 8, Kc, Vc, pr, concat + (i * C + base) * 8, i, Ckv, kvb, hd, scale);
            i = i + 1;
        }
        h = h + 1;
    }
    return 0;
}

# ---- forward (MHA / GQA) ----------------------------------------------------
# x(T,C) -> out(T,C). Projects Q/K/V, runs the shared core, applies Wo. Bias
# pointers bq/bk/bv/bo may be 0. pos_kind is carried for signature parity with
# attn11; only 0 (learned-absolute) is implemented — RoPE (1) is a later increment.
# rupantara uses rosnet's linear_fwd directly (attn11's qlinear_fwd is a pure
# passthrough to it off the ternary path, so this is bit-identical).
# Returns 0, RU_ERR_ARG() for pos_kind != 0 (through 0.5.1 a RoPE request silently ran
# learned-absolute attention), or RU_ERR_CFG() for a shape the core cannot index —
# both before anything is written. ar must hold ru_attn_arena_size(T, C, nh, nkv) f64.
fn ru_attn_fwd(Wq, bq, Wk, bk, Wv, bv, Wo, bo, x, out, ar, T, C, nh, nkv, pos_kind): i64 {
    if (pos_kind != 0) { return RU_ERR_ARG(); }
    if (_ru_attn_dims_ok(T, C, nh, nkv) == 0) { return RU_ERR_CFG(); }
    var Ckv = nkv * (C / nh);
    var Qc = _ru_at_Qc(ar);
    var Kc = _ru_at_Kc(ar, T, C);
    var Vc = _ru_at_Vc(ar, T, C, Ckv);
    var Pc = _ru_at_Pc(ar, T, C, Ckv);
    var concat = _ru_at_concat(ar, T, C, nh, Ckv);
    linear_fwd(x, Wq, bq, Qc, T, C, C);
    linear_fwd(x, Wk, bk, Kc, T, C, Ckv);
    linear_fwd(x, Wv, bv, Vc, T, C, Ckv);
    ru_attn_core_fwd(Qc, Kc, Vc, Pc, concat, T, C, nh, nkv);
    linear_fwd(concat, Wo, bo, out, T, C, C);
    return 0;
}

# ---- the model forward's attention: no Pc (0.6.0) ------------------------------
# ru_attn_fwd's projections, core and Wo over the lean arena (_ru_lean_arena_c:
# Qc | Kc | Vc | prow (T) | concat), for the block-stack forward, which never reads the
# probabilities again. Through 0.5.3 the model forward ran ru_attn_fwd, whose nh*T*T Pc
# was most of its scratch (6.0 of 6.84 GiB at GPT-2-small widths and T = 8192, past the
# 2 GiB per-allocation cap) and was zero-filled per block. The core is _ru_attn_core with
# Pc = 0: ru_attn_core_fwd's loop with one probability row reused, so `out` is
# bit-identical to ru_attn_fwd's. Dims trusted.
fn _ru_attn_fwd_lean(Wq, bq, Wk, bk, Wv, bv, Wo, bo, x, out, ar, T, C, nh, nkv): i64 {
    var Ckv = nkv * (C / nh);
    var Qc = ar;
    var Kc = Qc + (T * C) * 8;
    var Vc = Kc + (T * Ckv) * 8;
    var prow = Vc + (T * Ckv) * 8;
    var concat = prow + T * 8;
    linear_fwd(x, Wq, bq, Qc, T, C, C);
    linear_fwd(x, Wk, bk, Kc, T, C, Ckv);
    linear_fwd(x, Wv, bv, Vc, T, C, Ckv);
    _ru_attn_core(Qc, Kc, Vc, 0, prow, concat, T, C, nh, nkv);
    linear_fwd(concat, Wo, bo, out, T, C, C);
    return 0;
}
